// The camp's life between runs (plans/hub-hero-life.md, the creative advisor's):
// the temperaments a hero is given (a leading one and a second, or none: Quiet), what a hero of
// each does while it waits at its tent, and the lines it says. Flavour only: nothing here changes
// a run. A temperament's id is kept in the save once shipped: never change one.
//
// A line belongs to a temperament and a moment (`when`); `race` and `class` (ids of races.ron and
// classes.ron) keep it to heroes of that race or class, and `time_period` (Past, Present or Future: the time
// period chosen on the hero sheet) to heroes pulled in from then. A hero draws about two lines in three from
// its leading temperament and one in three from its second.
//
// The voice sheets, for whoever writes more lines (plan, section 3):
// * Human: plain, earnest; Stormwind, the Light, Lordaeron lost. "By the Light", "for Stormwind".
// * Dwarf: hearty; ale, the forge, Khaz Modan, the Explorers' League. "Aye", "by Magni's beard".
// * Night elf: long memory, formal, a little aloof; Elune, Teldrassil. "Elune-adore", "Ishnu-alah".
// * Gnome: bright, fast, counts things; Gnomeregan's fall a quiet hurt. "By my calculations".
// * Orc: honour, the clan, Thrall, the ancestors. "Lok'tar", "Throm-Ka", "Strength and honour".
// * Troll: laid-back, the loa, the Darkspear. "Mon", "da loa" (a word or two a line, never more).
// * Tauren: slow, warm, the Earth Mother, An'she and Mu'sha. "Walk with the Earth Mother".
// * Forsaken: dry, morbid, politely unsettling; the Dark Lady, Lordaeron as their home. Witty.
// The camp is at the Caverns of Time in Tanaris, and its heroes were pulled in from many times: a
// line may speak of home as it stood then (Stratholme before the plague, Gnomeregan before it fell,
// Draenor before the Portal) or be muddled about the year. A line that names a time other than
// the classic era, or holds only in it, names its time period: a Past hero knows nothing of what came
// after, and a Future hero has seen the classic world change. In an exchange a side names it the same way.
// A hero beaten in a run was overrun and came back: "overrun", "fell back", never "died". A line
// may name a zone or a boss, never a number, and never as if the trouble were gone for good
// ("Hogger won't bother anyone for now").
(
    temperaments: [
        (
            id: "stalwart",
            name: "Stalwart",
            voice: "Steady, dutiful, few words: we go again.",
            icon: "INV_Shield_06",
            poses: [Kneel],
            gestures: [Salute, Yes, Point],
        ),
        (
            id: "boisterous",
            name: "Boisterous",
            voice: "Loud and jolly, boasts, laughs at itself.",
            icon: "INV_Drink_05",
            poses: [Dance],
            gestures: [Cheer, Laugh, Flex, Roar, Eat],
        ),
        (
            id: "grim",
            name: "Grim",
            voice: "Dour, dry, expects the worst.",
            icon: "INV_Misc_Bone_HumanSkull_01",
            poses: [],
            gestures: [No, Point],
        ),
        (
            id: "curious",
            name: "Curious",
            voice: "Wonders, asks, counts things, reads.",
            icon: "INV_Misc_Book_09",
            poses: [Kneel],
            gestures: [Question, Exclamation, Point],
        ),
        (
            id: "mischievous",
            name: "Mischievous",
            voice: "Jokes, teases, light fingers, shrugs.",
            icon: "INV_Misc_Bell_01",
            poses: [Dance],
            gestures: [Laugh, Point, Chicken, Bow],
        ),
        (
            id: "devout",
            name: "Devout",
            voice: "Faith or the spirits first, calm, blesses.",
            icon: "Spell_Holy_HolyBolt",
            poses: [Kneel],
            gestures: [Kneel, Bow, Yes],
        ),
        (
            id: "weary",
            name: "Weary",
            voice: "Tired and kind, a veteran who has seen it all.",
            icon: "Spell_Nature_Sleep",
            poses: [],
            gestures: [No, Eat, Yes],
        ),
    ],
    lines: [
        // Stalwart
        (temperament: "stalwart", when: Idle, race: Some("human"), class: Some("warrior"), text: "Tent's up and my blade's oiled. Say when."),
        (temperament: "stalwart", when: ToPlayer, race: Some("dwarf"), text: "Aye, I'm ready. Been ready since breakfast."),
        (temperament: "stalwart", when: Loss, race: Some("human"), class: Some("paladin"), text: "We fell back in good order. I'd call that the Light's doing."),
        (temperament: "stalwart", when: Night, race: Some("orc"), text: "I'll take the watch. Sleep, all of you. Lok'tar."),
        (temperament: "stalwart", when: Win, race: Some("tauren"), text: "The Earth Mother walked with us today. Rest now, and we will walk again tomorrow."),
        (temperament: "stalwart", when: Idle, race: Some("night_elf"), text: "I have kept watch through more nights than I can count. One more will not trouble me."),
        // Boisterous
        (temperament: "boisterous", when: Idle, race: Some("dwarf"), text: "Who's got the ale? Chromie says it's evening in some year or other. That'll do me."),
        (temperament: "boisterous", when: Win, race: Some("dwarf"), class: Some("warrior"), text: "HA! Did you see that one go down? Bring me the next!"),
        (temperament: "boisterous", when: ToPlayer, race: Some("orc"), text: "Throm-Ka! You look terrible. Good run, then?"),
        (temperament: "boisterous", when: Loss, race: Some("troll"), text: "Ya got overrun, mon? Happens to da best of us. Happens to me a lot."),
        (temperament: "boisterous", when: Newcomer, race: Some("gnome"), text: "A NEW FACE! Do you like puzzles? You'll like me. Everyone likes me."),
        (temperament: "boisterous", when: Idle, race: Some("orc"), class: Some("mage"), text: "Yes, I'm an orc with a book. The axe is under my bed if it makes you feel better."),
        // Grim
        (temperament: "grim", when: Idle, race: Some("undead"), text: "I died once already. The second time had better be interesting."),
        (temperament: "grim", when: Loss, race: Some("human"), text: "There were more of them than us. There usually are, in this line of work."),
        (temperament: "grim", when: Idle, race: Some("night_elf"), text: "The fire's smoke clings to everything. In my forest, we would not light one."),
        (temperament: "grim", when: ToPlayer, race: Some("dwarf"), text: "Going out again? Good. Sitting here is worse."),
        (temperament: "grim", when: Night, race: Some("undead"), class: Some("paladin"), text: "The Light burns me a little, every day. I hardly notice it any more."),
        (temperament: "grim", when: Idle, race: Some("troll"), class: Some("warlock"), text: "Da loa gave me a demon for company. I'd have asked for a dog."),
        // Curious
        (temperament: "curious", when: Idle, race: Some("gnome"), text: "I've been counting them. They come in waves of... well, I lost count at the bit where I ran."),
        (temperament: "curious", when: ToPlayer, race: Some("gnome"), class: Some("priest"), text: "Does the Light work because we believe, or do we believe because it works? Hold still, I want to test something."),
        (temperament: "curious", when: Idle, race: Some("dwarf"), text: "The Chronicler lent me a book about the Titans. He's in it more than they are."),
        (temperament: "curious", when: Win, race: Some("human"), class: Some("mage"), text: "Whatever held that place was younger than it looked. I'd like a closer look when it comes back."),
        (temperament: "curious", when: Idle, race: Some("troll"), time_period: Some(Past), text: "Zanzil sold my uncle a potion once. My uncle still walkin' around, mon. Stopped breathin' a while back."),
        (temperament: "curious", when: Idle, race: Some("tauren"), class: Some("druid"), text: "An elf and a tauren in cat shape make two very different cats. I've been wondering why."),
        // Mischievous
        (temperament: "mischievous", when: Idle, race: Some("gnome"), class: Some("rogue"), text: "Nobody check their pockets. It's fine. Everything's fine."),
        (temperament: "mischievous", when: ToPlayer, race: Some("undead"), text: "You're back! I put your tent back up. It fell down. On its own. Twice."),
        (temperament: "mischievous", when: Loss, race: Some("dwarf"), class: Some("rogue"), text: "Overrun? Me? I was leading them away. Very far away. Towards the exit."),
        (temperament: "mischievous", when: Idle, race: Some("troll"), text: "I told da tauren the Mask grants wishes. He been at it an hour, mon."),
        (temperament: "mischievous", when: Newcomer, race: Some("human"), text: "Welcome! Sit near the fire and far from the paladin. He snores."),
        (temperament: "mischievous", when: Idle, race: Some("orc"), class: Some("hunter"), text: "My wolf ate the merchant's lunch. I told her it was a reward for bravery."),
        // Devout
        (temperament: "devout", when: Idle, race: Some("human"), class: Some("paladin"), text: "I pray for the win. The Light gives me another try, and I take it gladly."),
        (temperament: "devout", when: Night, race: Some("night_elf"), class: Some("priest"), text: "Elune-adore. The White Lady is bright tonight. She looked just the same over Zin-Azshari."),
        (temperament: "devout", when: Loss, race: Some("tauren"), text: "Walk with the Earth Mother. She caught you when you fell, little one."),
        (temperament: "devout", when: Idle, race: Some("dwarf"), class: Some("shaman"), text: "My totem's a mace planted head-up. The spirits of the deep stone haven't complained yet."),
        (temperament: "devout", when: Idle, race: Some("troll"), text: "Da loa be watchin' us, mon. Best behave a little."),
        (temperament: "devout", when: Win, race: Some("undead"), class: Some("priest"), time_period: Some(Present), text: "Lordaeron was ours once. Every place we clear, I think of its streets. We'll lose this one again too, I expect."),
        // Weary
        (temperament: "weary", when: Idle, race: Some("human"), text: "I asked Chromie what year it was. She asked me which one I wanted."),
        (temperament: "weary", when: ToPlayer, race: Some("orc"), text: "Another run already? Strength and honour, friend. And a nap first, if the ancestors allow."),
        (temperament: "weary", when: Loss, race: Some("dwarf"), text: "Lad, I've been overrun by better. Sit down and have a drink, and we'll talk about it after."),
        (temperament: "weary", when: Idle, race: Some("night_elf"), text: "I have slept very little these last few centuries. I'll not start tonight."),
        (temperament: "weary", when: Night, race: Some("tauren"), text: "The plains are quiet at night too. Quieter than here. Someone's sharpening again."),
        (temperament: "weary", when: Idle, race: Some("gnome"), time_period: Some(Present), text: "They opened the new tram the week I left. I never got a ride. Is it still running?"),
        // the odd race and class pairs the game allows
        (temperament: "devout", when: Idle, race: Some("undead"), class: Some("paladin"), text: "People ask how a Forsaken bears the Light. Badly. But I bear it."),
        (temperament: "stalwart", when: Idle, race: Some("human"), class: Some("hunter"), text: "Stormwind said hunters were a dwarf's trade. The boar disagreed."),
        (temperament: "devout", when: Idle, race: Some("dwarf"), class: Some("shaman"), text: "The elements took a while to answer a dwarf. Turns out they like stone."),
        (temperament: "curious", when: Loss, race: Some("gnome"), class: Some("priest"), text: "The shield held. The gnome holding it fell over. I'm working on the gnome."),
        (temperament: "boisterous", when: Newcomer, race: Some("orc"), class: Some("mage"), text: "Lok'tar. I set things on fire from further away than you do. We'll get along."),
        (temperament: "weary", when: Night, race: Some("troll"), class: Some("warlock"), text: "Da imp don't sleep. Neither do I. We stare at each other till mornin'."),

        // The full pools (the creative advisor's, 2026-10-31). Neutral lines name no race, no
        // class, no place and none of the camp's people, so they fit any hero in either camp.

        // Stalwart: neutral
        (temperament: "stalwart", when: Idle, text: "Boots laced, blade sharp. That's the whole of my morning."),
        (temperament: "stalwart", when: Idle, text: "Somebody has to keep watch over the camp. Today it's me. Tomorrow it's me as well."),
        (temperament: "stalwart", when: Idle, text: "I checked the tent ropes. Then I checked them again. They're fine."),
        (temperament: "stalwart", when: Idle, text: "The road won't clear itself. I've watched; it doesn't."),
        (temperament: "stalwart", when: Idle, text: "A quiet camp is a good camp. I mean to keep it that way."),
        (temperament: "stalwart", when: Idle, text: "I'll rest later. Someone ought to stay on their feet."),
        (temperament: "stalwart", when: ToPlayer, text: "Ready when you are. Just say the word."),
        (temperament: "stalwart", when: ToPlayer, text: "Good to see you on your feet. Where to next?"),
        (temperament: "stalwart", when: ToPlayer, text: "Going out? I'll walk with you, if you'll have me."),
        (temperament: "stalwart", when: ToPlayer, text: "Your gear looks sound. So does mine. Shall we?"),
        (temperament: "stalwart", when: ToPlayer, text: "You lead and I'll follow. Always have."),
        (temperament: "stalwart", when: ToPlayer, text: "Need anything before you go? I've a spare whetstone."),
        (temperament: "stalwart", when: Loss, text: "We fell back. Patch yourself up and we'll go again."),
        (temperament: "stalwart", when: Loss, text: "They pushed us out, that's all. Up you get."),
        (temperament: "stalwart", when: Loss, text: "Bandage it, eat something, and we'll take the ground back."),
        (temperament: "stalwart", when: Loss, text: "No shame in a retreat that keeps you breathing."),
        (temperament: "stalwart", when: Win, text: "Good work. Clean your blade and rest that arm while you can."),
        (temperament: "stalwart", when: Win, text: "We held. Get some sleep while it's quiet."),
        (temperament: "stalwart", when: Win, text: "Well fought. Eat something, then get your kit in order."),
        (temperament: "stalwart", when: Newcomer, text: "Welcome. Keep your blade clean and your word good, and you'll do fine here."),
        (temperament: "stalwart", when: Newcomer, text: "New blood. Good. Stand where I can see you and we'll get on."),
        (temperament: "stalwart", when: Newcomer, text: "Welcome to the warband. We look after our own."),
        (temperament: "stalwart", when: Night, text: "Go on, get some rest. I'll be up."),
        (temperament: "stalwart", when: Night, text: "Quiet out there tonight. I don't trust quiet, so I'm up."),
        (temperament: "stalwart", when: Night, text: "Fire's burning low. I'll feed it and keep an eye on the dark."),

        // Boisterous: neutral
        (temperament: "boisterous", when: Idle, text: "Who wants to hear how I won my last fight? Everyone? Excellent."),
        (temperament: "boisterous", when: Idle, text: "Who's the best fighter in this camp? Modesty forbids me. Ask the others!"),
        (temperament: "boisterous", when: Idle, text: "More wood on that fire! A camp should be loud and warm!"),
        (temperament: "boisterous", when: Idle, text: "Somebody sing! No? Fine, I'll sing. You've brought this on yourselves."),
        (temperament: "boisterous", when: Idle, text: "I got hit so hard out there I saw stars. I waved at them."),
        (temperament: "boisterous", when: Idle, text: "Best camp in the world, this! Never mind the food."),
        (temperament: "boisterous", when: ToPlayer, text: "There's the hero! Come here and tell me everything!"),
        (temperament: "boisterous", when: ToPlayer, text: "You look like you could use a drink and a story. I've got plenty of each!"),
        (temperament: "boisterous", when: ToPlayer, text: "Going out? Bring me back something big to brag about!"),
        (temperament: "boisterous", when: ToPlayer, text: "Ha! Strutting about like you own the camp. I like it!"),
        (temperament: "boisterous", when: ToPlayer, text: "Arm-wrestle? No? Coward. Later, then!"),
        (temperament: "boisterous", when: ToPlayer, text: "If you need someone to shout at the enemy, I've got the lungs for it!"),
        (temperament: "boisterous", when: Loss, text: "Overrun! Ha! It took a whole army to put you down. Be flattered!"),
        (temperament: "boisterous", when: Loss, text: "Chin up! The best stories start with getting knocked flat."),
        (temperament: "boisterous", when: Loss, text: "They got you? Next time I'll be right beside you, shouting at them."),
        (temperament: "boisterous", when: Win, text: "HA! Now THAT is how it's done! Somebody pour something!"),
        (temperament: "boisterous", when: Win, text: "Did you hear them run? Music, that is! Pure music!"),
        (temperament: "boisterous", when: Win, text: "We'll be telling this one round the fire until they make us stop!"),
        (temperament: "boisterous", when: Newcomer, text: "Fresh face! Sit by me, I'm the fun one. Ask anyone. Don't ask anyone."),
        (temperament: "boisterous", when: Newcomer, text: "Welcome, welcome! You're just in time to hear my best story."),
        (temperament: "boisterous", when: Newcomer, text: "Another sword arm for the warband! Tonight we celebrate! We celebrate most nights."),
        (temperament: "boisterous", when: Night, text: "Who's sleeping? Nobody's sleeping! The night is young and so am I!"),
        (temperament: "boisterous", when: Night, text: "Look at those stars! Somebody should write a song about them. Somebody's me."),
        (temperament: "boisterous", when: Night, text: "I'll keep it down. I won't. But I'll try."),

        // Grim: neutral
        (temperament: "grim", when: Idle, text: "They'll be back. They're always back."),
        (temperament: "grim", when: Idle, text: "Enjoy the fire while you've got it."),
        (temperament: "grim", when: Idle, text: "I sharpen this blade every night. It never gets sharp enough."),
        (temperament: "grim", when: Idle, text: "Everyone's cheerful. That's how you know something's coming."),
        (temperament: "grim", when: Idle, text: "Somebody told me this was a good living. I'd like a word with them."),
        (temperament: "grim", when: Idle, text: "Hope gets you overrun. I'd rather sharpen something."),
        (temperament: "grim", when: ToPlayer, text: "Back again. Still whole? Give it time."),
        (temperament: "grim", when: ToPlayer, text: "Going out? Bring a spare blade. And a spare plan."),
        (temperament: "grim", when: ToPlayer, text: "Don't look so pleased. You'll only annoy whatever's out there."),
        (temperament: "grim", when: ToPlayer, text: "You walk like someone who hasn't been hit lately. That'll change."),
        (temperament: "grim", when: ToPlayer, text: "If you've come for encouragement, try the fire. It's warmer than me."),
        (temperament: "grim", when: ToPlayer, text: "Watch your back out there. I'll be watching mine."),
        (temperament: "grim", when: Loss, text: "Overrun. Told you there'd be more of them."),
        (temperament: "grim", when: Loss, text: "They got you. They get all of us, now and then. Get up anyway."),
        (temperament: "grim", when: Loss, text: "Could have been worse. It usually is, next time."),
        (temperament: "grim", when: Win, text: "We won. Don't get used to it."),
        (temperament: "grim", when: Win, text: "Don't cheer too loud. Whatever's out there is listening."),
        (temperament: "grim", when: Win, text: "Good. It'll be quiet a while. A short while."),
        (temperament: "grim", when: Newcomer, text: "Another one. Don't unpack too much. We're never here long."),
        (temperament: "grim", when: Newcomer, text: "Welcome. The first few runs are the worst. After that they're only bad."),
        (temperament: "grim", when: Newcomer, text: "Fresh face. Keep it fresh as long as you can."),
        (temperament: "grim", when: Night, text: "Dark out. Things move in the dark. I'll sit up."),
        (temperament: "grim", when: Night, text: "The fire's burning low. Like everything."),
        (temperament: "grim", when: Night, text: "Can't sleep. Never can before a run. Or after one."),

        // Curious: neutral
        (temperament: "curious", when: Idle, text: "Why do they always come in from the edges? I've been drawing a little map of it."),
        (temperament: "curious", when: Idle, text: "The fire burns blue at the very bottom. I wonder why that is."),
        (temperament: "curious", when: Idle, text: "I've been writing down everything the enemy does. My notebook is getting worrying."),
        (temperament: "curious", when: Idle, text: "Has anyone noticed the bigger ones come later? There's a pattern. I'm sure of it."),
        (temperament: "curious", when: Idle, text: "If I could talk to them, I'd ask what they want. Before they hit me, ideally."),
        (temperament: "curious", when: Idle, text: "Every stone in this camp has a story. I've asked several. They're not talkative."),
        (temperament: "curious", when: ToPlayer, text: "Oh, good, you're back! What did you see out there? Anything odd? Everything odd?"),
        (temperament: "curious", when: ToPlayer, text: "Can I look at your boots? There's mud on them I don't recognise."),
        (temperament: "curious", when: ToPlayer, text: "Where are you heading? I'd like to know what grows there."),
        (temperament: "curious", when: ToPlayer, text: "Do you ever wonder who made the roads we fight on? I do. Constantly."),
        (temperament: "curious", when: ToPlayer, text: "Hold on, you've got something stuck to your armour. Can I keep it?"),
        (temperament: "curious", when: ToPlayer, text: "Tell me: when they swarm you, do they circle left or right? I've a bet on with myself."),
        (temperament: "curious", when: Loss, text: "Overrun? Fascinating. Well, not for you. But tell me exactly how it happened."),
        (temperament: "curious", when: Loss, text: "Every time we fall back I learn something. I've learned a great deal lately."),
        (temperament: "curious", when: Loss, text: "They came in faster at the end, didn't they? I thought so. Next time we'll be ready for that."),
        (temperament: "curious", when: Win, text: "We won! Now, what did they leave behind? I want to look at everything."),
        (temperament: "curious", when: Win, text: "Did you see how they broke at the end? I'd love to know what set them off."),
        (temperament: "curious", when: Win, text: "A win, and I took notes the whole way. Best day."),
        (temperament: "curious", when: Newcomer, text: "Hello! Where are you from? What do you carry? Do you snore? I'm collecting."),
        (temperament: "curious", when: Newcomer, text: "A newcomer! You must have so many questions. I have more. Let's trade."),
        (temperament: "curious", when: Newcomer, text: "Welcome! Tell me something I don't know. Anything. I'll wait."),
        (temperament: "curious", when: Night, text: "The stars move, you know. Slowly. I've been watching them do it."),
        (temperament: "curious", when: Night, text: "Something's calling out past the camp. An owl, I think. I hope."),
        (temperament: "curious", when: Night, text: "I can't sleep. Too many questions, and somebody's snoring."),

        // Mischievous: neutral
        (temperament: "mischievous", when: Idle, text: "I didn't touch anyone's boots. I may have moved them. Slightly. Up a tree."),
        (temperament: "mischievous", when: Idle, text: "If anyone asks, I was here the whole time."),
        (temperament: "mischievous", when: Idle, text: "The trader's counting coins again. I offered to help. Strangely, no."),
        (temperament: "mischievous", when: Idle, text: "I've hidden something in the camp, and nobody's even looking for it. Hurtful."),
        (temperament: "mischievous", when: Idle, text: "Somebody left their pack open. That's practically an invitation."),
        (temperament: "mischievous", when: Idle, text: "I told the newest of us the fire likes compliments. They've been flattering it all evening."),
        (temperament: "mischievous", when: ToPlayer, text: "Oh, hello! No, I wasn't in your tent. Why, what's missing?"),
        (temperament: "mischievous", when: ToPlayer, text: "You've got something on your face. No, the other side. No, that's just your face."),
        (temperament: "mischievous", when: ToPlayer, text: "Going out? Can I have your supper while you're gone? It'll only go cold."),
        (temperament: "mischievous", when: ToPlayer, text: "Psst. Want to know a secret? So do I. Tell me one."),
        (temperament: "mischievous", when: ToPlayer, text: "Fancy a game of cards? I'll deal."),
        (temperament: "mischievous", when: ToPlayer, text: "I'd wish you luck, but I've already borrowed all of it."),
        (temperament: "mischievous", when: Loss, text: "Lost? I prefer 'tactically elsewhere'."),
        (temperament: "mischievous", when: Loss, text: "Overrun, eh? Nobody saw. Well, I saw. But I'll only tell everyone."),
        (temperament: "mischievous", when: Loss, text: "Look on the bright side: nobody's ever been overrun at the camp. Yet."),
        (temperament: "mischievous", when: Win, text: "We won! I'm taking full credit. Someone has to."),
        (temperament: "mischievous", when: Win, text: "Nice work. I picked up a souvenir on the way out. Don't ask what."),
        (temperament: "mischievous", when: Win, text: "Victory! And nothing stolen. From us, I mean."),
        (temperament: "mischievous", when: Newcomer, text: "Welcome! I checked your tent for surprises. Found some. Left some."),
        (temperament: "mischievous", when: Newcomer, text: "A new friend! Never leave your boots outside. Just a friendly tip."),
        (temperament: "mischievous", when: Newcomer, text: "Hello there! Don't believe anything they say about me. Believe me instead."),
        (temperament: "mischievous", when: Night, text: "Everyone's asleep. Perfect. Time for some light rearranging."),
        (temperament: "mischievous", when: Night, text: "Shh. If you hear a noise in the night, it's the wind. It's always the wind."),
        (temperament: "mischievous", when: Night, text: "The stars are out, and so am I. Shh."),

        // Devout: neutral
        (temperament: "devout", when: Idle, text: "Every dawn is a gift. Every dusk, too, if you're still standing to see it."),
        (temperament: "devout", when: Idle, text: "I said a prayer for the camp this morning. For all of it. Even the loud ones."),
        (temperament: "devout", when: Idle, text: "The fire's warmth is a blessing. Small, but a blessing."),
        (temperament: "devout", when: Idle, text: "We go out without knowing how it ends. I call that faith."),
        (temperament: "devout", when: Idle, text: "Whatever watches over us, it's patient. I try to be the same."),
        (temperament: "devout", when: Idle, text: "Be still a moment. Listen. There. That's peace."),
        (temperament: "devout", when: ToPlayer, text: "Blessings on you. Go carefully, and come back to us."),
        (temperament: "devout", when: ToPlayer, text: "Let me say a word over you before you go. It can't hurt."),
        (temperament: "devout", when: ToPlayer, text: "You carry a heavy weight. Set it down here a while."),
        (temperament: "devout", when: ToPlayer, text: "Whatever you face out there, you won't face it alone."),
        (temperament: "devout", when: ToPlayer, text: "I prayed for you while you were gone. I'll pray again when you go."),
        (temperament: "devout", when: ToPlayer, text: "Peace, friend. Sit with me a moment before the road takes you."),
        (temperament: "devout", when: Loss, text: "You fell back, and you came back. That is a mercy. Rest now."),
        (temperament: "devout", when: Loss, text: "We're tested so we learn what we're made of. You're made of good stuff."),
        (temperament: "devout", when: Loss, text: "Be gentle with yourself. Tomorrow is a new chance."),
        (temperament: "devout", when: Win, text: "Give thanks. The day was ours, and we are all home."),
        (temperament: "devout", when: Win, text: "A blessed day. I'll light a candle for it tonight."),
        (temperament: "devout", when: Win, text: "Well done. That place can rest a while. Let's give thanks for it."),
        (temperament: "devout", when: Newcomer, text: "Welcome, friend. May you find rest here between the hard roads."),
        (temperament: "devout", when: Newcomer, text: "Blessings on your arrival. Sit, warm yourself. You're among friends."),
        (temperament: "devout", when: Newcomer, text: "Another soul to watch over. I'm glad of it. Welcome."),
        (temperament: "devout", when: Night, text: "The moon's up. A good time for quiet words to whoever listens."),
        (temperament: "devout", when: Night, text: "Sleep well, all of you. I'll keep a prayer burning with the fire."),
        (temperament: "devout", when: Night, text: "The night is long, but it always ends. Some nights that's my whole faith."),

        // Weary: neutral
        (temperament: "weary", when: Idle, text: "My knees have opinions about this camp. None of them kind."),
        (temperament: "weary", when: Idle, text: "I've fought worse. I just can't remember when, which is either good or bad."),
        (temperament: "weary", when: Idle, text: "Someone wake me if the world ends. Otherwise, don't."),
        (temperament: "weary", when: Idle, text: "The young ones run everywhere. I walk. I get there all the same."),
        (temperament: "weary", when: Idle, text: "Every scar's a story. I've stopped telling them. They run long."),
        (temperament: "weary", when: Idle, text: "Ah, a log to sit on. Best thing I've seen all day."),
        (temperament: "weary", when: ToPlayer, text: "Off again? Good for you. I'll be right here. Sitting."),
        (temperament: "weary", when: ToPlayer, text: "Take a breath before you go. They'll keep."),
        (temperament: "weary", when: ToPlayer, text: "You remind me of me, before I got tired. Don't get tired."),
        (temperament: "weary", when: ToPlayer, text: "Mind your footing out there. It's the footing that gets you, in the end."),
        (temperament: "weary", when: ToPlayer, text: "Back already? Sit a moment. The world can wait while you have a drink."),
        (temperament: "weary", when: ToPlayer, text: "I'd come with you, but my boots are off and they're staying off."),
        (temperament: "weary", when: Loss, text: "Overrun, eh? Happens to all of us. Sit, eat. It looks smaller after supper."),
        (temperament: "weary", when: Loss, text: "I've fallen back more times than I can remember. Still here."),
        (temperament: "weary", when: Loss, text: "There, there. You're home. That's what matters tonight."),
        (temperament: "weary", when: Win, text: "A good day. Let's not spoil it with talk. Pass the bread."),
        (temperament: "weary", when: Win, text: "Well done. Fighting always gives me an appetite. Let's eat."),
        (temperament: "weary", when: Win, text: "Won, did we? Good. Now I can sit down with a clear conscience."),
        (temperament: "weary", when: Newcomer, text: "Welcome. Pace yourself. That's all the wisdom I've got left."),
        (temperament: "weary", when: Newcomer, text: "Another young one, full of fire. Keep a bit of it back for later."),
        (temperament: "weary", when: Newcomer, text: "Hello. Your tent leaks a little. They all do. You get used to it."),
        (temperament: "weary", when: Night, text: "Finally. The best part of the day: the part where I lie down."),
        (temperament: "weary", when: Night, text: "Night. Quiet. A warm fire. I'll take it."),
        (temperament: "weary", when: Night, text: "I'll sleep where I sit, I think. Someone throw a blanket over me."),

        // Stalwart: by race
        (temperament: "stalwart", when: Idle, race: Some("human"), time_period: Some(Past), text: "My family's in {Area(2017)}. I promised I'd be home for the harvest."),
        (temperament: "stalwart", when: ToPlayer, race: Some("human"), text: "By the Light, you're back. Stormwind would be proud. I am."),
        (temperament: "stalwart", when: Night, race: Some("human"), time_period: Some(Past), text: "The last watch I stood was on Lordaeron's walls, with the Horde's fires all down the valley. This one's quieter."),
        (temperament: "stalwart", when: Idle, race: Some("dwarf"), time_period: Some(Past), text: "When I left {Area(1537)}, old Modimus was High King and all three clans still drank at one table."),
        (temperament: "stalwart", when: ToPlayer, race: Some("dwarf"), time_period: Some(Past), text: "Any word from Muradin? Last I heard he'd taken a company up to Northrend."),
        (temperament: "stalwart", when: Newcomer, race: Some("dwarf"), text: "Welcome. Whatever year ye came from, the ale's the same."),
        (temperament: "stalwart", when: Idle, race: Some("night_elf"), time_period: Some(Present), text: "The Sentinels keep watch over {Area(331)}. This camp will have to make do with me."),
        (temperament: "stalwart", when: ToPlayer, race: Some("night_elf"), text: "Ishnu-alah. I am ready when you are. I have been ready for a long time."),
        (temperament: "stalwart", when: Win, race: Some("night_elf"), text: "Ishnu-alah. The land breathes easier tonight. We should rest while it does."),
        (temperament: "stalwart", when: Idle, race: Some("gnome"), time_period: Some(Present), text: "{Area(133)} will be ours again. Until then, I'll hold this bit of sand."),
        (temperament: "stalwart", when: ToPlayer, race: Some("gnome"), text: "Calculations done, kit checked, courage... mostly topped up. Ready!"),
        (temperament: "stalwart", when: Idle, race: Some("orc"), text: "The grass in Nagrand came up to your knees. I mean to walk in it again."),
        (temperament: "stalwart", when: ToPlayer, race: Some("orc"), text: "Lok'tar. Point me at them and step aside."),
        (temperament: "stalwart", when: Win, race: Some("orc"), text: "Lok'tar ogar! The ancestors saw that one."),
        (temperament: "stalwart", when: Idle, race: Some("troll"), time_period: Some(Past), text: "Sen'jin says da Darkspear stand together. So I stand."),
        (temperament: "stalwart", when: ToPlayer, race: Some("troll"), text: "Ready when ya are. Darkspear don't run."),
        (temperament: "stalwart", when: Idle, race: Some("tauren"), text: "Cairne taught us to stand like the bluffs. The wind goes by; the bluffs stay."),
        (temperament: "stalwart", when: ToPlayer, race: Some("tauren"), text: "I walked with Cairne when he was a young bull. He never once asked where we were going. Lead on."),
        (temperament: "stalwart", when: Loss, race: Some("tauren"), text: "The herd scatters, and the herd gathers again. Gather with us, friend."),
        (temperament: "stalwart", when: Idle, race: Some("undead"), time_period: Some(Present), text: "The Dark Lady watches. I stand a little straighter. What's left of me."),
        (temperament: "stalwart", when: ToPlayer, race: Some("undead"), text: "No need to wait on me. The dead don't tire. Lead on."),

        // Boisterous: by race
        (temperament: "boisterous", when: Idle, race: Some("human"), text: "In {Area(87)} they'd buy me a drink for a day like this. Here they hand me a whetstone."),
        (temperament: "boisterous", when: ToPlayer, race: Some("human"), text: "Ha! You fight like a Stormwind guard! I mean that kindly!"),
        (temperament: "boisterous", when: Win, race: Some("human"), time_period: Some(Past), text: "Wait till they hear about this in Lordaeron! Prince Arthas might buy me a drink himself!"),
        (temperament: "boisterous", when: Idle, race: Some("dwarf"), time_period: Some(Present), text: "By Magni's beard, call this hot? Go and stand by the Great Forge some time!"),
        (temperament: "boisterous", when: ToPlayer, race: Some("dwarf"), text: "Fancy a pint after? Thurgen says never before a run. Thurgen's no fun."),
        (temperament: "boisterous", when: Win, race: Some("dwarf"), text: "Drinks are on me! Well, on the Explorers' League. They don't know it yet."),
        (temperament: "boisterous", when: Loss, race: Some("dwarf"), text: "Overrun, eh? I'd say I sat down, sudden-like."),
        (temperament: "boisterous", when: Idle, race: Some("night_elf"), time_period: Some(Present), text: "I knew Malfurion when he was still learning from Cenarius. Now they say he sleeps for centuries at a stretch. He always did like a nap."),
        (temperament: "boisterous", when: ToPlayer, race: Some("night_elf"), text: "Race you round the camp! Fair warning: I was running before your grandmother's grandmother was born."),
        (temperament: "boisterous", when: Idle, race: Some("gnome"), time_period: Some(Present), text: "I worked on the {Area(2257)}! I held the lamp. It runs right under the water!"),
        (temperament: "boisterous", when: ToPlayer, race: Some("gnome"), text: "Did you hear about my last run? Everything exploded, and I'd planned most of it!"),
        (temperament: "boisterous", when: Win, race: Some("gnome"), text: "Success! Somebody tell Tobbin! Somebody write this down!"),
        (temperament: "boisterous", when: Idle, race: Some("orc"), text: "Zug zug! That means yes. To everything! Who's buying?"),
        (temperament: "boisterous", when: ToPlayer, race: Some("orc"), time_period: Some(Past), text: "Draka's due any day! Durotan says the whole clan feasts when the babe comes."),
        (temperament: "boisterous", when: Newcomer, race: Some("orc"), text: "A new face! Lok'tar! Can you lift that axe? Show me!"),
        (temperament: "boisterous", when: Idle, race: Some("troll"), text: "Who wanna hear about da time I wrestled a raptor? I got most of my fingers back."),
        (temperament: "boisterous", when: ToPlayer, race: Some("troll"), text: "Hey, mon! You came back smilin'. That's the spirit!"),
        (temperament: "boisterous", when: Win, race: Some("troll"), text: "Ha! We showed them, mon! Somebody beat the drums!"),
        (temperament: "boisterous", when: Idle, race: Some("tauren"), text: "Ha! The others think I am slow. Wait until I start dancing!"),
        (temperament: "boisterous", when: ToPlayer, race: Some("tauren"), text: "Little one! Come, sit! I've made enough stew for a whole tribe!"),
        (temperament: "boisterous", when: Idle, race: Some("undead"), text: "Ha! Another day not dead! Well, no deader than yesterday!"),
        (temperament: "boisterous", when: ToPlayer, race: Some("undead"), text: "I used to sing at the inn in {Area(159)}. Packed every night. The crowd's gone a bit quiet since."),

        // Grim: by race
        (temperament: "grim", when: Idle, race: Some("human"), time_period: Some(Present), text: "Lordaeron had walls too. Higher than ours. Look where it got them."),
        (temperament: "grim", when: ToPlayer, race: Some("human"), time_period: Some(Present), text: "Somebody said the king's gone missing. I asked which king. Got three answers."),
        (temperament: "grim", when: Loss, race: Some("human"), time_period: Some(Present), text: "We fell back, like they did in Lordaeron. Difference is, we had somewhere to fall back to."),
        (temperament: "grim", when: Idle, race: Some("dwarf"), time_period: Some(Past), text: "{Area(1037)}'s the finest hall in Khaz Modan. Some fool here says it's cursed now. I told him to mind his tongue."),
        (temperament: "grim", when: ToPlayer, race: Some("dwarf"), text: "Mind yerself out there. The ground's never as solid as it looks."),
        (temperament: "grim", when: Idle, race: Some("night_elf"), text: "The Highborne thought their magic would last forever. I watch our mages and wonder."),
        (temperament: "grim", when: ToPlayer, race: Some("night_elf"), text: "I watched the Legion pour out of the Well once. Go on. I've seen worse than whatever's out there."),
        (temperament: "grim", when: Idle, race: Some("gnome"), time_period: Some(Present), text: "I still dream of {Area(133)}'s halls. Then I dream of what lives in them now."),
        (temperament: "grim", when: ToPlayer, race: Some("gnome"), text: "By my calculations, the odds are terrible. I've rechecked. Still terrible."),
        (temperament: "grim", when: Idle, race: Some("orc"), text: "My father drank the demon's blood. I carry what he did into every fight."),
        (temperament: "grim", when: ToPlayer, race: Some("orc"), time_period: Some(Present), text: "Grom bought our freedom with his own blood. Don't waste the day he paid for."),
        (temperament: "grim", when: Idle, race: Some("troll"), time_period: Some(Present), text: "Zalazane still sits on da {Area(368)}. Some days I think about nothin' else."),
        (temperament: "grim", when: ToPlayer, race: Some("troll"), time_period: Some(Past), text: "I left {Area(19)} the night the Atal'ai started chantin' for Hakkar. Good timin', mon."),
        (temperament: "grim", when: Idle, race: Some("tauren"), text: "The Centaur drove us across the plains once. Something always wants the plains."),
        (temperament: "grim", when: ToPlayer, race: Some("tauren"), text: "Not every hunt ends with the hunter home by dark. Walk carefully, friend."),
        (temperament: "grim", when: Idle, race: Some("undead"), text: "I was human once. It did not take."),
        (temperament: "grim", when: ToPlayer, race: Some("undead"), time_period: Some(Present), text: "A human in the north basin asked me if the grain had reached {Area(2017)} yet. I said any day now."),
        (temperament: "grim", when: Loss, race: Some("undead"), text: "Overrun? Welcome to my world. You get used to it."),
        (temperament: "grim", when: Win, race: Some("undead"), text: "We won. How refreshing. I'm sure it will go back to normal soon."),

        // Curious: by race
        (temperament: "curious", when: Idle, race: Some("human"), time_period: Some(Past), text: "Last I saw Stormwind, the orcs had burned it flat. Wren tells me it's got canals now."),
        (temperament: "curious", when: ToPlayer, race: Some("human"), time_period: Some(Past), text: "Any word on the grain carts from Andorhal? {Area(2017)}'s been waiting on them all week."),
        (temperament: "curious", when: Idle, race: Some("dwarf"), text: "The Explorers' League would give their beards to see what we see on the road."),
        (temperament: "curious", when: ToPlayer, race: Some("dwarf"), text: "See any Titan stonework out there? Carvings, runes, big odd doors? Tell me if ye do."),
        (temperament: "curious", when: Idle, race: Some("night_elf"), text: "The dwarves call their mountains old. I try very hard not to smile."),
        (temperament: "curious", when: ToPlayer, race: Some("night_elf"), time_period: Some(Past), text: "Is the Queen still holding court in Zin-Azshari? I have a petition I never got to give her."),
        (temperament: "curious", when: Night, race: Some("night_elf"), text: "The tauren call her Mu'sha. We say Elune. I think she answers to either."),
        (temperament: "curious", when: Idle, race: Some("gnome"), text: "Zazzi let me look into the Orb. I saw myself as a dwarf. The beard suited me."),
        (temperament: "curious", when: ToPlayer, race: Some("gnome"), time_period: Some(Past), text: "People keep saying {Area(133)} fell. I left it this morning. It was a bit green round the vents, I suppose."),
        (temperament: "curious", when: Loss, race: Some("gnome"), text: "By my calculations, we should have won. I'm checking my calculations."),
        (temperament: "curious", when: Idle, race: Some("orc"), text: "The shamans say the elements remember everything. I'd like to ask them about my grandfather."),
        (temperament: "curious", when: ToPlayer, race: Some("orc"), time_period: Some(Past), text: "Why does everyone here call Draenor '{Area(676)}'? Out of what land?"),
        (temperament: "curious", when: Idle, race: Some("troll"), time_period: Some(Past), text: "When I left, the Gurubashi ruled every jungle south of the mountains. Now dey say {Area(19)}'s full of Hakkar's priests, mon."),
        (temperament: "curious", when: ToPlayer, race: Some("troll"), text: "What ya bring back from out there? Bones, feathers, somethin' shiny? I collect."),
        (temperament: "curious", when: Idle, race: Some("tauren"), text: "An'she warms the day, Mu'sha watches the night. I wonder what they say to each other at dusk."),
        (temperament: "curious", when: ToPlayer, race: Some("tauren"), time_period: Some(Past), text: "My tribe was still on the long walk when I left. Now they say we live on top of a mesa. Who carries the water up?"),
        (temperament: "curious", when: Idle, race: Some("undead"), time_period: Some(Present), text: "The Royal Apothecary Society would love a sample of whatever we fight. I have jars. I'm only saying."),
        (temperament: "curious", when: ToPlayer, race: Some("undead"), text: "Does it hurt, being alive? I've quite forgotten. Do tell."),

        // Mischievous: by race
        (temperament: "mischievous", when: Idle, race: Some("human"), text: "I told Marshal Hale the dwarves keep a secret ale stash in the armoury. He's been searching all morning."),
        (temperament: "mischievous", when: ToPlayer, race: Some("human"), text: "Wren's tour skips the best spot in the camp: where I hide the good biscuits."),
        (temperament: "mischievous", when: Idle, race: Some("dwarf"), text: "I swapped Tobbin's ink for ale. His next chapter's going to be very cheerful."),
        (temperament: "mischievous", when: ToPlayer, race: Some("dwarf"), text: "Don't tell Thurgen I borrowed his hammer. Don't tell him I lost it, either."),
        (temperament: "mischievous", when: Idle, race: Some("night_elf"), time_period: Some(Present), text: "I told the gnome I remember the Sundering. She's followed me with a notebook ever since."),
        (temperament: "mischievous", when: ToPlayer, race: Some("night_elf"), text: "{Spell(743)} is a gift of Elune. I mostly use it to listen in. You were humming."),
        (temperament: "mischievous", when: Idle, race: Some("gnome"), text: "Zazzi turned herself into a human again. I asked if she could do a goat. She did not find that funny."),
        (temperament: "mischievous", when: ToPlayer, race: Some("gnome"), text: "Your pack's ticking. That'll be one of my clockwork beetles. I'd take it out."),
        (temperament: "mischievous", when: Newcomer, race: Some("gnome"), text: "Welcome! Don't pull the red lever. There isn't a red lever. Yet."),
        (temperament: "mischievous", when: Idle, race: Some("orc"), text: "I hid in a crate to surprise the sentries. Fell asleep. Very surprising for everyone."),
        (temperament: "mischievous", when: ToPlayer, race: Some("orc"), text: "Throm-Ka! I saved you a seat by the fire. Ignore the bucket on it."),
        (temperament: "mischievous", when: Idle, race: Some("troll"), text: "I put a little voodoo doll by da fire. Nobody know who it is. Not even me."),
        (temperament: "mischievous", when: ToPlayer, race: Some("troll"), text: "Stay away from the voodoo, mon. Especially the bit in your boots."),
        (temperament: "mischievous", when: Newcomer, race: Some("troll"), text: "Welcome, mon! Your tent comes with a free snake. No refunds."),
        (temperament: "mischievous", when: Idle, race: Some("tauren"), text: "Nobody suspects the tauren. That is why it is always the tauren."),
        (temperament: "mischievous", when: ToPlayer, race: Some("tauren"), text: "I sat on someone's tent by mistake. Was it yours? I hope it was yours."),
        (temperament: "mischievous", when: Idle, race: Some("undead"), text: "I stood very still by the fire and someone tried to hang a pot on me. I let them."),
        (temperament: "mischievous", when: ToPlayer, race: Some("undead"), text: "Boo. No? Nothing? Tough crowd."),
        (temperament: "mischievous", when: Night, race: Some("undead"), text: "Night already? I hadn't noticed. It's all rather dim to me."),

        // Devout: by race
        (temperament: "devout", when: Idle, race: Some("human"), time_period: Some(Past), text: "I pray for King Terenas every night. The others go quiet when I do."),
        (temperament: "devout", when: ToPlayer, race: Some("human"), text: "The Light go with you. It's seen me through worse than this."),
        (temperament: "devout", when: Newcomer, race: Some("human"), text: "Welcome, friend. The Light brought you here; Wren will show you the rest."),
        (temperament: "devout", when: Idle, race: Some("dwarf"), text: "The Titans shaped this stone. I like to think they'd be pleased we're still standing on it."),
        (temperament: "devout", when: ToPlayer, race: Some("dwarf"), text: "May the stone hold firm under ye, and the forge stay warm till ye're back."),
        (temperament: "devout", when: Idle, race: Some("night_elf"), text: "Elune-adore. Even here, far from the moonwells, she finds me."),
        (temperament: "devout", when: ToPlayer, race: Some("night_elf"), text: "May Elune light your path, and keep you when the light fails."),
        (temperament: "devout", when: Idle, race: Some("gnome"), time_period: Some(Present), text: "Mekkatorque believes we'll go home. That's enough faith for me, and a little spare."),
        (temperament: "devout", when: ToPlayer, race: Some("gnome"), text: "I say a little prayer before every run. Then I check my wiring. Belt and braces."),
        (temperament: "devout", when: Idle, race: Some("orc"), time_period: Some(Present), text: "On Draenor our ancestors' spirits rested at Oshu'gun. I hope someone still visits them."),
        (temperament: "devout", when: ToPlayer, race: Some("orc"), text: "May the ancestors guide your hand and the spirits guard your back."),
        (temperament: "devout", when: Night, race: Some("orc"), text: "The ancestors speak softest after dark. Listen with me a while."),
        (temperament: "devout", when: Idle, race: Some("troll"), text: "The spirits like a little offering. I give dem the burnt bits of supper."),
        (temperament: "devout", when: ToPlayer, race: Some("troll"), text: "Da loa walk with you today. I asked dem nicely."),
        (temperament: "devout", when: Night, race: Some("troll"), text: "The loa walk at night, mon. Leave them be and they'll leave you be."),
        (temperament: "devout", when: Idle, race: Some("tauren"), text: "The Earth Mother holds this ground as she holds all ground. We are never far from home."),
        (temperament: "devout", when: ToPlayer, race: Some("tauren"), text: "Walk with the Earth Mother, friend. And may An'she warm your path."),
        (temperament: "devout", when: Night, race: Some("tauren"), text: "Mu'sha watches tonight. Sleep well, friends. She keeps the dark kind."),
        (temperament: "devout", when: Newcomer, race: Some("tauren"), text: "Welcome, friend. The Earth Mother sent you; there is always room at the fire."),
        (temperament: "devout", when: Idle, race: Some("undead"), text: "Some of us still pray. The Light rarely answers. I keep the line open."),
        (temperament: "devout", when: ToPlayer, race: Some("undead"), time_period: Some(Present), text: "The Dark Lady's blessing on you. She seldom gives them, so I hand them out for her."),

        // Weary: by race
        (temperament: "weary", when: Idle, race: Some("human"), time_period: Some(Present), text: "I farmed in {Area(40)} before the Defias came. I miss the quiet. Even the bad harvests."),
        (temperament: "weary", when: ToPlayer, race: Some("human"), text: "I keep counting the days to harvest. Chromie says I've missed a few hundred of them."),
        (temperament: "weary", when: Idle, race: Some("dwarf"), time_period: Some(Past), text: "Chromie says home's a few hundred years that way. Too far for these knees."),
        (temperament: "weary", when: ToPlayer, race: Some("dwarf"), text: "Sit, sit. Me beard's more grey than black these days, and it's earned every hair."),
        (temperament: "weary", when: Night, race: Some("dwarf"), text: "Back home ye'd smell the Great Forge from the gates at this hour. I miss that smell."),
        (temperament: "weary", when: Idle, race: Some("night_elf"), text: "I have watched forests grow, burn and grow again. A camp is a short thing to watch."),
        (temperament: "weary", when: ToPlayer, race: Some("night_elf"), text: "Sit, friend. The trees are patient. We can be too."),
        (temperament: "weary", when: Loss, race: Some("night_elf"), text: "We withdrew. The forest withdraws every winter, and every spring it returns."),
        (temperament: "weary", when: Idle, race: Some("gnome"), text: "I used to run everywhere. Now I calculate the shortest path and nap somewhere along it."),
        (temperament: "weary", when: ToPlayer, race: Some("gnome"), text: "Another run? My legs are short and they've been very busy lately."),
        (temperament: "weary", when: Night, race: Some("gnome"), time_period: Some(Present), text: "In {Area(133)} the lights never went out. These days I rather like the dark."),
        (temperament: "weary", when: Idle, race: Some("orc"), time_period: Some(Present), text: "I grew up in the internment camps. A tent by a fire is luxury, whatever the others say."),
        (temperament: "weary", when: ToPlayer, race: Some("orc"), text: "Sit, friend. Even the Warchief has to rest sometime."),
        (temperament: "weary", when: Loss, race: Some("orc"), time_period: Some(Present), text: "We fell back. The old Horde never learned how, and look what became of it. Rest."),
        (temperament: "weary", when: Idle, race: Some("troll"), text: "I miss the islands, mon. Warm sand, and nobody handin' me a blade."),
        (temperament: "weary", when: ToPlayer, race: Some("troll"), text: "Sit down a while. Even a raptor rests between hunts, ya know."),
        (temperament: "weary", when: Loss, race: Some("troll"), text: "You fell back? Good. Fallin' back is how ya get old."),
        (temperament: "weary", when: Idle, race: Some("tauren"), time_period: Some(Past), text: "When I left, there were no orcs on Kalimdor. Now they live next door. They snore."),
        (temperament: "weary", when: ToPlayer, race: Some("tauren"), text: "Rest a while, friend. The kodo know: you go farther when you go slow."),
        (temperament: "weary", when: Win, race: Some("tauren"), text: "Well run, little ones. Now let the old bull sit."),
        (temperament: "weary", when: Idle, race: Some("undead"), time_period: Some(Present), text: "I was a baker in Andorhal. We had a very good year for grain, right up to the end."),
        (temperament: "weary", when: ToPlayer, race: Some("undead"), time_period: Some(Present), text: "Go on, then. I'll be here. I had years of practice at waiting in Tirisfal."),
        (temperament: "weary", when: Newcomer, race: Some("undead"), text: "Welcome. The living here are very friendly. Exhaustingly so."),

        // By class: warrior
        (temperament: "stalwart", when: Idle, class: Some("warrior"), text: "Keep your shield up and your feet planted, and the rest tends to sort itself out."),
        (temperament: "boisterous", when: ToPlayer, class: Some("warrior"), text: "Feel that? That's rage, that is! Or the stew. Hard to tell."),
        (temperament: "grim", when: Idle, class: Some("warrior"), text: "Every dent in this shield is a blow that didn't reach someone else. It's running out of room."),
        (temperament: "weary", when: Idle, class: Some("warrior"), text: "Charge in and take the hits. My bones know the routine by now."),
        (temperament: "curious", when: ToPlayer, class: Some("warrior"), text: "Why do they always go for whoever shouts loudest? I shout, they come. Never fails."),
        (temperament: "mischievous", when: Loss, class: Some("warrior"), text: "Overrun? I was taunting them. Clearly it worked."),

        // By class: paladin
        (temperament: "devout", when: Idle, class: Some("paladin"), text: "The Light asks very little. Stand between the weak and the worst of it."),
        (temperament: "stalwart", when: ToPlayer, class: Some("paladin"), text: "A blessing before you go? On the house. It's always on the house."),
        (temperament: "weary", when: Idle, class: Some("paladin"), text: "My armour weighs more every season. Or I weigh less. The Light keeps me guessing."),
        (temperament: "boisterous", when: Win, class: Some("paladin"), text: "The Light shone today, and I shone with it! Did you see me glow?"),
        (temperament: "grim", when: Night, class: Some("paladin"), text: "The Light feels a long way off at night. I keep my hammer close till it comes back."),
        (temperament: "mischievous", when: ToPlayer, class: Some("paladin"), text: "I can bless your blade, your boots or your breakfast. The breakfast needs it most."),

        // By class: hunter
        (temperament: "stalwart", when: Idle, class: Some("hunter"), text: "My pet's fed, my quiver's full. Now I can think about myself."),
        (temperament: "curious", when: Idle, class: Some("hunter"), text: "The tracks round the camp tell stories. Something big passed last night. Something bigger followed."),
        (temperament: "mischievous", when: ToPlayer, class: Some("hunter"), text: "Careful where you step. My pet's buried something there, and I think it was your boot."),
        (temperament: "weary", when: ToPlayer, class: Some("hunter"), text: "Have you seen my pet? It's behind me, isn't it. It's always behind me."),
        (temperament: "boisterous", when: Win, class: Some("hunter"), text: "My pet got more of them than you did! Don't take it personally. I did."),
        (temperament: "devout", when: Night, class: Some("hunter"), text: "The wild sleeps, and so does my beast. I'll sit up and listen for the pack."),

        // By class: rogue
        (temperament: "mischievous", when: Idle, class: Some("rogue"), text: "I was never here. You didn't see me. Lovely weather."),
        (temperament: "grim", when: ToPlayer, class: Some("rogue"), text: "Keep your purse close and your back to a wall. Nothing personal. Habit."),
        (temperament: "curious", when: Idle, class: Some("rogue"), text: "I've picked every lock in the camp, just to see if I could. I put everything back."),
        (temperament: "stalwart", when: Loss, class: Some("rogue"), text: "We slipped out on our own terms. I'll take that."),
        (temperament: "boisterous", when: ToPlayer, class: Some("rogue"), text: "Look what I found! Don't ask whose it was. It's mine now. I'm generous with it."),
        (temperament: "weary", when: Night, class: Some("rogue"), text: "Night's my time. Funny how all I want to do with it now is sleep."),

        // By class: priest
        (temperament: "devout", when: Idle, class: Some("priest"), text: "I can mend the body and steady the mind. The rest is between you and whatever you pray to."),
        (temperament: "curious", when: ToPlayer, class: Some("priest"), text: "Sometimes I hear whispers in the dark when I pray. Do you? No? Forget I asked."),
        (temperament: "weary", when: Loss, class: Some("priest"), text: "Hold still. There. A little light, a little rest. You'll be on your feet by supper."),
        (temperament: "grim", when: Idle, class: Some("priest"), text: "I can mend a wound in a heartbeat. The ones you can't see take longer."),
        (temperament: "mischievous", when: ToPlayer, class: Some("priest"), text: "I can shield you from harm. I can also make you run screaming. Be nice."),

        // By class: shaman
        (temperament: "devout", when: Idle, class: Some("shaman"), text: "The elements will speak to you if you listen. Usually they're complaining."),
        (temperament: "curious", when: Idle, class: Some("shaman"), text: "This fire has a temper. I've been talking it round."),
        (temperament: "stalwart", when: ToPlayer, class: Some("shaman"), text: "My totems are set. Wherever you stand out there, the spirits stand with you."),
        (temperament: "mischievous", when: Idle, class: Some("shaman"), text: "I asked the wind to blow the smoke elsewhere. It's blowing it at whoever's singing. I like this wind."),
        (temperament: "weary", when: Night, class: Some("shaman"), text: "The elements are quiet tonight. Even they need rest."),

        // By class: mage
        (temperament: "curious", when: Idle, class: Some("mage"), text: "Conjured bread tastes of nothing. I've been trying to give it some flavour. So far it tastes faintly of feet."),
        (temperament: "boisterous", when: ToPlayer, class: Some("mage"), text: "Need water? Bread? Something set on fire? I take requests!"),
        (temperament: "mischievous", when: Idle, class: Some("mage"), text: "I turned a rabbit into a sheep, then back into a rabbit. Nobody noticed. Art is lonely."),
        (temperament: "grim", when: Loss, class: Some("mage"), text: "Blink, run, blink, run. Sooner or later you run out of blink."),
        (temperament: "weary", when: ToPlayer, class: Some("mage"), text: "Too tired to teleport. Too tired to walk. I'll sit here and think about it."),
        (temperament: "stalwart", when: Win, class: Some("mage"), text: "The arcane held, and so did we. Rest the mind before the next."),

        // By class: warlock
        (temperament: "grim", when: Idle, class: Some("warlock"), text: "Every gift from the Nether has a price. I keep very good accounts."),
        (temperament: "mischievous", when: ToPlayer, class: Some("warlock"), text: "Don't mind the imp. He only throws fire at people I don't like, and he's a poor shot."),
        (temperament: "curious", when: Idle, class: Some("warlock"), text: "The demon whispers secrets at night. Most of them are lies. The rest are worse."),
        (temperament: "stalwart", when: ToPlayer, class: Some("warlock"), text: "My demon's on a short leash. You're safer here than you'll be anywhere else today."),
        (temperament: "weary", when: Night, class: Some("warlock"), text: "My voidwalker never sleeps. It looms over my bedroll all night. Comforting, in its way."),
        (temperament: "devout", when: Idle, class: Some("warlock"), text: "Even a warlock prays. I pray the bindings hold."),

        // By class: druid
        (temperament: "devout", when: Idle, class: Some("druid"), text: "Cenarius taught that all living things are kin. Even the ones who snore."),
        (temperament: "weary", when: Idle, class: Some("druid"), text: "Boots. Why must there be boots? A bear never needed boots."),
        (temperament: "curious", when: ToPlayer, class: Some("druid"), text: "In the Dream this place would be greener and a good deal quieter. I'd like to see it."),
        (temperament: "mischievous", when: Idle, class: Some("druid"), text: "I sat by the trader's stall as a cat. I was given a saucer of milk. I took it."),
        (temperament: "stalwart", when: Night, class: Some("druid"), text: "I'll take the watch in cat form. I see better, and I complain less."),
        (temperament: "boisterous", when: Win, class: Some("druid"), text: "Did you see me as a bear? Magnificent! I'd stay that way if I could hold a cup."),

        // The odd race and class pairs: more
        (temperament: "stalwart", when: Idle, race: Some("human"), class: Some("hunter"), text: "The dwarves taught me to track. My wolf taught me to wait. I'm still learning from them."),
        (temperament: "boisterous", when: Win, race: Some("human"), class: Some("hunter"), text: "Stormwind doesn't breed hunters, they told me. Stormwind should see my trophies!"),
        (temperament: "curious", when: Idle, race: Some("dwarf"), class: Some("shaman"), text: "The earth spirits under this sand are old and slow to answer. Good thing I'm patient. Mostly."),
        (temperament: "grim", when: ToPlayer, race: Some("dwarf"), class: Some("shaman"), text: "The elements are stubborn. So am I. We'll see who gives in."),
        (temperament: "devout", when: ToPlayer, race: Some("gnome"), class: Some("priest"), text: "I've calibrated my faith and it's running beautifully. Here, a blessing, freshly tuned."),
        (temperament: "mischievous", when: Idle, race: Some("gnome"), class: Some("priest"), text: "I put a shield on the stew pot. The stew's been safe for hours. Nobody can get at it, either."),
        (temperament: "grim", when: Idle, race: Some("orc"), class: Some("mage"), text: "The old Horde's warlocks drank power and paid for it. I study mine slowly. I won't pay that price."),
        (temperament: "boisterous", when: ToPlayer, race: Some("orc"), class: Some("mage"), text: "Throm-Ka! Frost is my favourite. Nobody expects an orc to be cool."),
        (temperament: "stalwart", when: ToPlayer, race: Some("undead"), class: Some("paladin"), text: "The Light stings, but it hasn't turned me away. Stand behind me; I'll take the sting for you too."),
        (temperament: "curious", when: Idle, race: Some("undead"), class: Some("paladin"), text: "If the Light hates the dead so much, why does it still answer me? I ask it daily."),
        (temperament: "mischievous", when: ToPlayer, race: Some("troll"), class: Some("warlock"), text: "My imp says he likes you, mon. That's bad news."),
        (temperament: "devout", when: Idle, race: Some("troll"), class: Some("warlock"), text: "The loa and the demons don't get along. I keep dem in separate pockets."),

        // By race and time period: a hero pulled in from the Past (before the classic era:
        // the Second War, Lordaeron before the plague, Draenor before the Portal, Zin-Azshari), the
        // Present (the classic era itself) or the Future (after it) talks of home as it stood then.
        // Human
        (temperament: "stalwart", when: Idle, race: Some("human"), time_period: Some(Past), text: "I followed Lothar off the boats from Stormwind. I'd follow him here too, if he'd turn up."),
        (temperament: "boisterous", when: ToPlayer, race: Some("human"), time_period: Some(Past), text: "Prince Arthas owes me silver from a card game. I mean to collect when I'm home."),
        (temperament: "grim", when: Night, race: Some("human"), time_period: Some(Past), text: "Every night I wonder if the orcs have crossed the {Area(330)} yet. Then I remember where I am."),
        (temperament: "devout", when: ToPlayer, race: Some("human"), time_period: Some(Past), text: "Archbishop Faol blessed my mother's house when I was small. I carry a bit of that with me."),
        (temperament: "weary", when: Idle, race: Some("human"), time_period: Some(Past), text: "King Terenas raised the tax for the orc camps again before I left. Nobody's collecting out here, at least."),
        (temperament: "stalwart", when: ToPlayer, race: Some("human"), time_period: Some(Present), text: "Highlord Bolvar keeps order in the city till the king's found. I can keep order out here. After you."),
        (temperament: "mischievous", when: Idle, race: Some("human"), time_period: Some(Present), text: "Lady Prestor smiled at me once in the keep. I checked my purse after. All there. Odd."),
        (temperament: "grim", when: Idle, race: Some("human"), time_period: Some(Present), text: "My brother rides with the Argent Dawn now. His letters smell of the Plaguelands."),
        (temperament: "curious", when: ToPlayer, race: Some("human"), time_period: Some(Present), text: "Is it true the prisoners run the Stockade now? Somebody ought to go in and ask."),
        (temperament: "weary", when: Idle, race: Some("human"), time_period: Some(Present), text: "My uncle helped rebuild Stormwind and never saw his wages. Last I heard he'd gone to {Area(40)} and bought a mask."),
        (temperament: "stalwart", when: Night, race: Some("human"), time_period: Some(Future), text: "I was on the wall the night Deathwing came down on Stormwind. Keep an eye on the sky for me."),
        (temperament: "boisterous", when: ToPlayer, race: Some("human"), time_period: Some(Future), text: "I was in Orgrimmar when Garrosh fell. Took a spoon from Grommash Hold. Very fine spoon."),
        (temperament: "grim", when: Idle, race: Some("human"), time_period: Some(Future), text: "Anduin wears his father's crown now. It's too big for him. He'll grow, if they let him."),
        (temperament: "curious", when: Idle, race: Some("human"), time_period: Some(Future), text: "I've been to Pandaria. Turtles the size of hills, and everyone wanted to feed me."),
        (temperament: "devout", when: ToPlayer, race: Some("human"), time_period: Some(Future), text: "I saw Tirion Fordring break the Lich King's sword at Icecrown. The Light was close that day. I felt it."),
        // Dwarf
        (temperament: "boisterous", when: Idle, race: Some("dwarf"), time_period: Some(Past), text: "The Wildhammers flew their gryphons over {Area(1537)} this morning, showing off. We threw bread at them."),
        (temperament: "grim", when: Night, race: Some("dwarf"), time_period: Some(Past), text: "The orcs came up through {Area(269)} when I was young. I keep my axe by the bed."),
        (temperament: "curious", when: ToPlayer, race: Some("dwarf"), time_period: Some(Past), text: "Is the Alliance still paying us for those cannons? Last I looked they owed us a mountain of gold."),
        (temperament: "devout", when: Idle, race: Some("dwarf"), time_period: Some(Past), text: "Pray the Titans keep Thaurissan in his mountain. He's been calling on things no dwarf should."),
        (temperament: "stalwart", when: ToPlayer, race: Some("dwarf"), time_period: Some(Past), text: "I fought the Amani in the Hinterlands under Turalyon. Aye, point me at something."),
        (temperament: "mischievous", when: Idle, race: Some("dwarf"), time_period: Some(Present), text: "Magni's daughter ran off with the Dark Iron emperor. Kidnapped, the king says. We all say kidnapped."),
        (temperament: "curious", when: Idle, race: Some("dwarf"), time_period: Some(Present), text: "The League brought some talking discs out of Uldaman. Say we were made of stone once. I knocked on my arm to check."),
        (temperament: "boisterous", when: ToPlayer, race: Some("dwarf"), time_period: Some(Present), text: "You've been to {Area(131)}? Thunderbrew's finest! I'd walk through the snow for another mug."),
        (temperament: "grim", when: Night, race: Some("dwarf"), time_period: Some(Present), text: "The Dark Irons are digging under Blackrock again. I hear hammers when it's quiet."),
        (temperament: "stalwart", when: ToPlayer, race: Some("dwarf"), time_period: Some(Present), text: "The Horde sat outside {Area(1537)}'s gates once and never got in. Right, where are we off to?"),
        (temperament: "grim", when: Idle, race: Some("dwarf"), time_period: Some(Future), text: "Magni read from a stone tablet and turned to diamond. I don't read anything I find any more."),
        (temperament: "mischievous", when: ToPlayer, race: Some("dwarf"), time_period: Some(Future), text: "The Council of Three Hammers argues every morning. I take a stool and some bread and watch."),
        (temperament: "curious", when: Idle, race: Some("dwarf"), time_period: Some(Future), text: "Magni talks to the world itself now. Says it's hurting. I asked if it said anything about me."),
        (temperament: "boisterous", when: Idle, race: Some("dwarf"), time_period: Some(Future), text: "We had a Dark Iron in the tavern back home, buying rounds. The whole place went quiet. Then we drank."),
        (temperament: "weary", when: Idle, race: Some("dwarf"), time_period: Some(Future), text: "The Twilight's Hammer filled {Area(1037)} with dragons. Falstad's lot won't go near it."),
        // Gnome
        (temperament: "boisterous", when: Idle, race: Some("gnome"), time_period: Some(Past), text: "The Alliance wants more of our flying machines! I've drawn the wings already. The landing's next week's problem."),
        (temperament: "mischievous", when: ToPlayer, race: Some("gnome"), time_period: Some(Past), text: "Have you met Sicco Thermaplugg? Lovely fellow. Ever so keen on the High Tinker's job."),
        (temperament: "stalwart", when: Idle, race: Some("gnome"), time_period: Some(Past), text: "We've had troggs in the lower vents again. The High Tinker says it's nothing. I believe him."),
        (temperament: "weary", when: Idle, race: Some("gnome"), time_period: Some(Past), text: "I left my soldering iron on in {Area(133)}. Somebody will have noticed by now. Probably."),
        (temperament: "grim", when: Idle, race: Some("gnome"), time_period: Some(Past), text: "Thermaplugg wants to flush the troggs out with radiation. Seems a bit much to me."),
        (temperament: "curious", when: Idle, race: Some("gnome"), time_period: Some(Present), text: "{Area(1537)} gave us a whole district. Tinker Town. We filled it with noise in a week."),
        (temperament: "mischievous", when: ToPlayer, race: Some("gnome"), time_period: Some(Present), text: "I sold a dwarf a self-pouring mug. It pours itself mostly onto the dwarf."),
        (temperament: "grim", when: Night, race: Some("gnome"), time_period: Some(Present), text: "Thermaplugg's still down there, sitting on the throne. I can't sleep for thinking of it."),
        (temperament: "boisterous", when: Idle, race: Some("gnome"), time_period: Some(Present), text: "We're going back for {Area(133)} any day now! I've packed. I've been packed for a while."),
        (temperament: "boisterous", when: Idle, race: Some("gnome"), time_period: Some(Future), text: "We took {Area(133)} back! Well, the front door and a nice bit of lawn. It's a start!"),
        (temperament: "curious", when: ToPlayer, race: Some("gnome"), time_period: Some(Future), text: "There's a whole island of metal gnomes off {Area(21)}. Mechagon. They keep offering me upgrades."),
        (temperament: "stalwart", when: Idle, race: Some("gnome"), time_period: Some(Future), text: "I marched on {Area(133)} with the High Tinker. The trogg smell took weeks to wash out."),
        (temperament: "weary", when: Idle, race: Some("gnome"), time_period: Some(Future), text: "Our new town sits in the snow by the gate. My workshop leaks when it thaws."),
        (temperament: "mischievous", when: Idle, race: Some("gnome"), time_period: Some(Future), text: "Chromie asked which year I'm from. I gave her the date in gnomish. She's still working it out."),
        // Night elf
        (temperament: "stalwart", when: Idle, race: Some("night_elf"), time_period: Some(Past), text: "I stood guard on the Queen's palace steps. Lord Xavius never once said good morning."),
        (temperament: "curious", when: Idle, race: Some("night_elf"), time_period: Some(Past), text: "The Highborne have been at the Well again. The sky over Zin-Azshari was green when I left."),
        (temperament: "devout", when: Night, race: Some("night_elf"), time_period: Some(Past), text: "Elune's moon is the same here as over the Well. I am glad of that."),
        (temperament: "boisterous", when: ToPlayer, race: Some("night_elf"), time_period: Some(Past), text: "In Zin-Azshari we danced till dawn on the palace terraces. You'd have loved it."),
        (temperament: "weary", when: Idle, race: Some("night_elf"), time_period: Some(Past), text: "They say my city is under the sea now, and has been for ages. I have not yet found the strength to ask after my sister."),
        (temperament: "stalwart", when: ToPlayer, race: Some("night_elf"), time_period: Some(Present), text: "Ishnu-alah. Shandris trained me at Feathermoon. My bow is yours when you go out."),
        (temperament: "grim", when: Idle, race: Some("night_elf"), time_period: Some(Present), text: "Arch Druid Staghelm grows a little stranger every year. Nobody says so. I say so."),
        (temperament: "curious", when: Idle, race: Some("night_elf"), time_period: Some(Present), text: "{Area(141)}'s leaves never fall. I have checked. A great many times."),
        (temperament: "devout", when: ToPlayer, race: Some("night_elf"), time_period: Some(Present), text: "Tyrande leads the prayers in {Area(1657)}. I miss hearing her voice at dusk."),
        (temperament: "weary", when: Night, race: Some("night_elf"), time_period: Some(Present), text: "The Emerald Dream calls the druids, and some of them never wake. I keep my own sleep short."),
        (temperament: "grim", when: Idle, race: Some("night_elf"), time_period: Some(Future), text: "I watched {Area(141)} burn from the boats. I don't look at campfires for long."),
        (temperament: "weary", when: ToPlayer, race: Some("night_elf"), time_period: Some(Future), text: "We're guests in Stormwind now. The humans are kind. Their trees are very small."),
        (temperament: "boisterous", when: Idle, race: Some("night_elf"), time_period: Some(Future), text: "Tyrande and Malfurion married at last! We'd all given up asking."),
        (temperament: "stalwart", when: Idle, race: Some("night_elf"), time_period: Some(Future), text: "I fought on Mount {Area(616)} when Ragnaros came for the World Tree. It is still beautiful up there."),
        (temperament: "devout", when: ToPlayer, race: Some("night_elf"), time_period: Some(Future), text: "Tyrande took the Night Warrior into herself. Her eyes went black as the new moon. I pray for her still."),
        // Orc
        (temperament: "stalwart", when: Idle, race: Some("orc"), time_period: Some(Past), text: "Ner'zhul says the ancestors are angry. I sharpen my axe and wait for him to say more."),
        (temperament: "boisterous", when: ToPlayer, race: Some("orc"), time_period: Some(Past), text: "The clans hunt talbuk in Nagrand every spring. You should come. Bring a big spear."),
        (temperament: "grim", when: Night, race: Some("orc"), time_period: Some(Past), text: "A warlock called Gul'dan has the elders' ear. Nobody in my clan likes his smell. I sleep upwind of him."),
        (temperament: "devout", when: Idle, race: Some("orc"), time_period: Some(Past), text: "Before I came here I walked to Oshu'gun to hear the ancestors. They had a great deal to say."),
        (temperament: "weary", when: Idle, race: Some("orc"), time_period: Some(Past), text: "The elders argue about the draenei every night back home. Here there's only the wind. I could get used to it."),
        (temperament: "boisterous", when: Idle, race: Some("orc"), time_period: Some(Present), text: "Thrall built Orgrimmar from nothing. I carried the logs. Ask anyone. Well, ask me."),
        (temperament: "curious", when: ToPlayer, race: Some("orc"), time_period: Some(Present), text: "Have you been to the Valley of Spirits? The trolls showed me a dance there. I'm still learning it."),
        (temperament: "stalwart", when: Night, race: Some("orc"), time_period: Some(Present), text: "My old sergeant said a warrior sleeps light. I sleep light. Some nights I don't sleep at all."),
        (temperament: "grim", when: Idle, race: Some("orc"), time_period: Some(Present), text: "The Warsong cut {Area(331)} and the night elves cut them back. It'll end badly."),
        (temperament: "stalwart", when: Idle, race: Some("orc"), time_period: Some(Future), text: "Garrosh made Orgrimmar all iron and spikes. We had to take it back from him ourselves."),
        (temperament: "grim", when: ToPlayer, race: Some("orc"), time_period: Some(Future), text: "Saurfang walked out alone to fight the Banshee Queen. He didn't walk back."),
        (temperament: "curious", when: Idle, race: Some("orc"), time_period: Some(Future), text: "Thrall wed Aggra, a shaman from Nagrand. Their boy talks to rocks, and the rocks answer."),
        (temperament: "boisterous", when: Win, race: Some("orc"), time_period: Some(Future), text: "Lok'tar! Felt just like storming Icecrown! Warmer, though!"),
        (temperament: "weary", when: Idle, race: Some("orc"), time_period: Some(Future), text: "We went back to Draenor through some trick of time. I met my own grandfather there. He was rude."),
        // Troll
        (temperament: "boisterous", when: Idle, race: Some("troll"), time_period: Some(Past), text: "In {Area(19)} we feasted every new moon. I never once paid for my own drink, mon."),
        (temperament: "mischievous", when: ToPlayer, race: Some("troll"), time_period: Some(Past), text: "I sold a Zandalari priest a raptor egg. It was a rock. He's still sittin' on it, mon."),
        (temperament: "grim", when: Idle, race: Some("troll"), time_period: Some(Past), text: "Da Amani marched off with the Horde. Zul'jin wants his forests back from the elves. I'd rather stay on my island."),
        (temperament: "devout", when: Idle, race: Some("troll"), time_period: Some(Past), text: "Sen'jin reads da bones every morning. Dey keep tellin' him about a green-skinned chief."),
        (temperament: "stalwart", when: ToPlayer, race: Some("troll"), time_period: Some(Past), text: "Da murlocs came up our beach every night back home. I'm used to fightin' in the dark."),
        (temperament: "boisterous", when: ToPlayer, race: Some("troll"), time_period: Some(Present), text: "Vol'jin says da Horde is family now. I got a lot of cousins, mon. Some of them green."),
        (temperament: "curious", when: Idle, race: Some("troll"), time_period: Some(Present), text: "Da Sandfury in {Area(978)} keep a beast with too many heads in a pool. I'd like to see it. From far off."),
        (temperament: "devout", when: Night, race: Some("troll"), time_period: Some(Present), text: "I leave a little rum out for da loa every night. Somebody drinks it. I choose to think it's da loa."),
        (temperament: "weary", when: Idle, race: Some("troll"), time_period: Some(Present), text: "{Area(367)} is nice. Dry, though. Da scorpids keep gettin' in my hammock."),
        (temperament: "stalwart", when: Idle, race: Some("troll"), time_period: Some(Future), text: "Vol'jin took back da {Area(368)}. I was there. We ran Zalazane right off da beach."),
        (temperament: "devout", when: Night, race: Some("troll"), time_period: Some(Future), text: "Vol'jin was warchief for a little while. Dey say he walks with da loa now. I talk to him some nights."),
        (temperament: "boisterous", when: Idle, race: Some("troll"), time_period: Some(Future), text: "I been to Zuldazar! Golden pyramid big as a mountain, mon! Da Zandalari think our huts are cute."),
        (temperament: "grim", when: Idle, race: Some("troll"), time_period: Some(Future), text: "Da Alliance came right into Dazar'alor and killed King Rastakhan. Talanji wears da crown now."),
        (temperament: "mischievous", when: ToPlayer, race: Some("troll"), time_period: Some(Future), text: "I told a pandaren monk I was a loa. He bowed. I let him."),
        // Tauren
        (temperament: "stalwart", when: Idle, race: Some("tauren"), time_period: Some(Past), text: "The centaur harried us all along the long walk. I kept the kodo fed and my head down."),
        (temperament: "devout", when: Night, race: Some("tauren"), time_period: Some(Past), text: "Every night of the long walk we slept under Mu'sha's eye. She found us here too."),
        (temperament: "curious", when: ToPlayer, race: Some("tauren"), time_period: Some(Past), text: "Have you met these orcs everyone speaks of? Green, I hear. With tusks. I would like to see one."),
        (temperament: "boisterous", when: Idle, race: Some("tauren"), time_period: Some(Past), text: "My tribe has the fastest kodo on the plains. I raced him once. He won."),
        (temperament: "weary", when: Idle, race: Some("tauren"), time_period: Some(Past), text: "The Grimtotem argue with Cairne at every fire. I left before the shouting started this time."),
        (temperament: "stalwart", when: ToPlayer, race: Some("tauren"), time_period: Some(Present), text: "Cairne keeps the bluffs safe and the elders fed. I would like to do as well here."),
        (temperament: "curious", when: Idle, race: Some("tauren"), time_period: Some(Present), text: "Hamuul Runetotem studies with the night elf druids in {Area(493)}. He comes home smelling of moss."),
        (temperament: "grim", when: Idle, race: Some("tauren"), time_period: Some(Present), text: "Magatha smiles at Cairne in council. I have seen kinder smiles on a hyena."),
        (temperament: "boisterous", when: Idle, race: Some("tauren"), time_period: Some(Present), text: "From the top of {Area(1638)} you can see all of {Area(215)}. You can also fall off. I did both."),
        (temperament: "weary", when: Night, race: Some("tauren"), time_period: Some(Present), text: "The Venture Company are digging in {Area(215)} again. I hear their machines in my sleep."),
        (temperament: "grim", when: Idle, race: Some("tauren"), time_period: Some(Future), text: "Cairne fell in a duel with Garrosh. The blade was poisoned. Magatha's doing."),
        (temperament: "stalwart", when: ToPlayer, race: Some("tauren"), time_period: Some(Future), text: "Baine leads us now. He is young, and he stands like his father."),
        (temperament: "curious", when: Idle, race: Some("tauren"), time_period: Some(Future), text: "There are tauren in Highmountain with antlers! Moose antlers! I keep wanting to touch them."),
        (temperament: "weary", when: Idle, race: Some("tauren"), time_period: Some(Future), text: "The Banshee Queen locked Baine up for being kind to the Proudmoores. I was tired of wars before that one."),
        (temperament: "devout", when: Idle, race: Some("tauren"), time_period: Some(Future), text: "The Earth Mother was hurt when Deathwing tore the land. I felt it in {Area(215)}. It is healing."),
        // Forsaken
        (temperament: "weary", when: Idle, race: Some("undead"), time_period: Some(Past), text: "The voice in my head went quiet this morning. A woman with a bow says that's good news."),
        (temperament: "curious", when: ToPlayer, race: Some("undead"), time_period: Some(Past), text: "I lit the lamps in the capital. Who's been doing them since I left?"),
        (temperament: "grim", when: Idle, race: Some("undead"), time_period: Some(Past), text: "Last I remember, Prince Arthas came riding into {Area(2017)}. After that it gets a bit hazy."),
        (temperament: "boisterous", when: ToPlayer, race: Some("undead"), time_period: Some(Past), text: "I'm due back in Lordaeron for the king's feast. I hope I'm still invited. Looking like this."),
        (temperament: "devout", when: Idle, race: Some("undead"), time_period: Some(Past), text: "I sang in the chapel choir at Lordaeron. I still know every hymn. My voice has changed somewhat."),
        (temperament: "mischievous", when: ToPlayer, race: Some("undead"), time_period: Some(Present), text: "The apothecaries gave me a vial to carry. I'm told not to drop it. I'm told that often."),
        (temperament: "stalwart", when: Idle, race: Some("undead"), time_period: Some(Present), text: "The Scourge are just over the river in the Plaguelands. Let them come. We've met."),
        (temperament: "boisterous", when: Idle, race: Some("undead"), time_period: Some(Present), text: "{Area(1497)}'s lovely this time of year. Damp and green. Like always."),
        (temperament: "curious", when: Idle, race: Some("undead"), time_period: Some(Present), text: "Varimathras stands beside the Dark Lady all day. I wonder what he does at night."),
        (temperament: "grim", when: Idle, race: Some("undead"), time_period: Some(Future), text: "I was at the Wrathgate. Our own apothecaries poisoned the field. I've not trusted a vial since."),
        (temperament: "weary", when: Night, race: Some("undead"), time_period: Some(Future), text: "The Dark Lady left us. Just walked off. Some of us are still waiting by the door."),
        (temperament: "curious", when: ToPlayer, race: Some("undead"), time_period: Some(Future), text: "Calia Menethil says she's one of us now. A Menethil, undead. I've stopped trying to keep up."),
        (temperament: "stalwart", when: Idle, race: Some("undead"), time_period: Some(Future), text: "{Area(1497)} is choked with blight now. Her own doing. I'll find us somewhere else to stand."),
        (temperament: "mischievous", when: ToPlayer, race: Some("undead"), time_period: Some(Future), text: "Chromie asked which year I died. I gave her a few to choose from."),
    ],
    // Two heroes talking (plan, section 5): a hook, a reply, a sting, in turn. `first` and `second`
    // say who may speak each side (a temperament, leading or second, a race, a class; none: any).
    // `{hero}` is the played hero's name; `{zone}`, in Win and Loss, the zone its run was in.
    // Idle: any time; Win: after a zone won for the first time; Loss: after the played hero was
    // overrun.
    exchanges: [
        (when: Idle, first: (temperament: Some("boisterous"), race: Some("dwarf")), second: (temperament: Some("curious"), race: Some("gnome")), lines: ["How's the tram these days?", "Still runs. Still smells of you lot.", "Aye, that'll be the ale."]),
        (when: Idle, first: (temperament: Some("stalwart"), race: Some("human")), second: (race: Some("night_elf")), lines: ["We should go at first light.", "Light comes late here. We should go when we are ready.", "...First light, then."]),
        (when: Idle, first: (temperament: Some("stalwart"), race: Some("orc")), second: (temperament: Some("mischievous"), race: Some("troll")), lines: ["You moved my tent stakes.", "Da wind did it, mon.", "Then the wind has tusks."]),
        (when: Idle, first: (temperament: Some("grim"), race: Some("undead")), second: (race: Some("tauren")), lines: ["Does the Earth Mother take the dead?", "She takes everyone, friend.", "Hm. She's slow about it."]),
        (when: Idle, first: (temperament: Some("curious"), race: Some("gnome"), class: Some("priest")), second: (race: Some("human"), class: Some("paladin")), lines: ["Define 'Light'.", "The Light is.", "I'm writing that down as a shrug."]),
        (when: Idle, first: (class: Some("hunter")), second: (), lines: ["Have you seen my pet?", "It's behind you.", "She's always behind me. I never learn."]),
        (when: Idle, first: (temperament: Some("boisterous"), race: Some("orc"), class: Some("mage")), second: (race: Some("orc"), class: Some("warrior")), lines: ["Lok'tar! Spells!", "Lok'tar. Axe.", "We'll both go, then."]),
        (when: Loss, first: (), second: (), lines: ["They got {hero}.", "{hero}'ll be back on their feet by supper.", "Aye. Stubborn, that one."]),
        (when: Win, first: (), second: (), lines: ["{zone}'s clear?", "Clear enough. Gives me hope for the next one."]),

        // The full pool (the creative advisor's, 2026-10-31). A side with no race may be anyone of
        // either camp, so its lines name no people, place or faith of their own; Alliance and Horde
        // never share a camp, so no exchange pairs the two.

        // Idle: the temperaments clash
        (when: Idle, first: (temperament: Some("boisterous")), second: (temperament: Some("grim")), lines: ["Cheer up! There's stew!", "The stew is why I'm not cheering.", "More for me, then!"]),
        (when: Idle, first: (temperament: Some("grim")), second: (temperament: Some("boisterous")), lines: ["They'll be back, you know.", "Good! I wasn't finished with them!", "You actually mean that, don't you."]),
        (when: Idle, first: (temperament: Some("weary")), second: (temperament: Some("curious")), lines: ["Still reading that?", "It's different every time I read it.", "That'll be you, then. You never sleep."]),
        (when: Idle, first: (temperament: Some("curious")), second: (temperament: Some("grim")), lines: ["If they always come back, where do they go in between?", "Somewhere worse than here.", "Fascinating. Let's go and look.", "Absolutely not."]),
        (when: Idle, first: (temperament: Some("stalwart")), second: (temperament: Some("mischievous")), lines: ["Someone has been at my whetstone.", "Someone? Could be anyone in this camp.", "It's sticking out of your pack."]),
        (when: Idle, first: (temperament: Some("mischievous")), second: (temperament: Some("stalwart")), lines: ["You keep watch all night?", "All night.", "Then who took your boots?"]),
        (when: Idle, first: (temperament: Some("grim")), second: (temperament: Some("devout")), lines: ["Pray all you like. They still come.", "I pray we're still standing when they do.", "Put in a word for my knees while you're at it."]),
        (when: Idle, first: (temperament: Some("curious")), second: (temperament: Some("devout")), lines: ["What do you ask for, when you pray?", "Nothing. I listen.", "And what do you hear?", "Mostly you."]),
        (when: Idle, first: (temperament: Some("weary")), second: (temperament: Some("devout")), lines: ["Say a prayer for me too, would you?", "I always do.", "Quietly, though. I'm trying to sleep."]),
        (when: Idle, first: (temperament: Some("boisterous")), second: (temperament: Some("devout")), lines: ["Does your faith let you drink?", "My faith is patient with those who do.", "Then I'm its greatest test!"]),
        (when: Idle, first: (temperament: Some("mischievous")), second: (temperament: Some("devout")), lines: ["Bless my dice?", "I'll bless you. The dice are on their own.", "Fair. They're weighted anyway."]),
        (when: Idle, first: (temperament: Some("boisterous")), second: (temperament: Some("weary")), lines: ["Up! Up! The night is young!", "Good for the night. I'm old and I'm going to bed.", "Then I'll be young enough for both of us!"]),
        (when: Idle, first: (temperament: Some("boisterous")), second: (temperament: Some("stalwart")), lines: ["Did you see me out there? Magnificent!", "I saw you.", "And?", "And I was behind you, catching what you missed."]),
        (when: Idle, first: (temperament: Some("mischievous")), second: (temperament: Some("grim")), lines: ["Go on, smile. I'll pay you.", "With my own coin, I expect.", "You count it? How dull."]),
        (when: Idle, first: (temperament: Some("grim")), second: (temperament: Some("grim")), lines: ["Lovely night.", "Is it?", "No."]),
        (when: Idle, first: (temperament: Some("curious")), second: (temperament: Some("curious")), lines: ["Have you noticed the fire's warmer on whichever side you aren't?", "Yes! I've been going round it all evening.", "So have I. We keep swapping."]),

        // Idle: the fire and the camp
        (when: Idle, first: (), second: (), lines: ["Who put wet wood on the fire?", "It wasn't wet when I found it.", "Where did you find it?", "...In the water barrel."]),
        (when: Idle, first: (), second: (), lines: ["Who's snoring?", "The tent at the end.", "That tent's empty.", "...Then who's snoring?"]),
        (when: Idle, first: (temperament: Some("grim")), second: (temperament: Some("boisterous")), lines: ["The fire's dying.", "Then I'll sing to it!", "Let it die in peace."]),
        (when: Idle, first: (temperament: Some("curious")), second: (temperament: Some("stalwart")), lines: ["Who keeps the fire going all night?", "I do.", "When do you sleep?", "After."]),

        // Idle: the Alliance
        (when: Idle, first: (race: Some("dwarf"), time_period: Some(Present)), second: (race: Some("gnome"), time_period: Some(Present)), lines: ["{Area(133)}. Still think on it?", "Every day. We'll take it back.", "Aye. And {Area(1537)} will be right behind you when you do."]),
        (when: Idle, first: (temperament: Some("boisterous"), race: Some("dwarf")), second: (race: Some("gnome")), lines: ["What year d'you reckon it is back home?", "By my calculations, all of them at once.", "Good. Then the ale's fresh somewhere."]),
        (when: Idle, first: (temperament: Some("mischievous"), race: Some("gnome")), second: (race: Some("dwarf")), lines: ["I've improved your axe.", "My axe didn't need improving.", "It does now. Don't press the red bit."]),
        (when: Idle, first: (race: Some("human")), second: (race: Some("gnome"), time_period: Some(Present)), lines: ["What happened to {Area(133)}?", "A small radiation incident.", "Small?", "The gnomes were small."]),
        (when: Idle, first: (race: Some("night_elf")), second: (race: Some("human")), lines: ["You humans are always in such a hurry.", "We don't have forever.", "Neither do we. Not any more."]),
        (when: Idle, first: (temperament: Some("grim"), race: Some("night_elf")), second: (race: Some("human")), lines: ["Your fire is too large.", "It's cold out here once the sun's down.", "Elune keeps me warm.", "Then she's welcome to a seat by it."]),
        (when: Idle, first: (temperament: Some("curious"), race: Some("human")), second: (race: Some("night_elf")), lines: ["How long have you been fighting, really?", "Since before your kingdom had a name.", "And you still get nervous before a run?", "Every time. It is why I am still here."]),
        (when: Idle, first: (temperament: Some("devout"), race: Some("human")), second: (temperament: Some("devout"), race: Some("night_elf")), lines: ["The Light watches over us.", "So does Elune. Perhaps they take turns.", "Then I'll thank whichever is on tonight."]),
        (when: Idle, first: (race: Some("dwarf")), second: (race: Some("human")), lines: ["Stormwind ale, is it?", "From the Lion's Pride. Best in Elwynn.", "Aye? Elwynn must be easily pleased."]),
        (when: Idle, first: (race: Some("human")), second: (race: Some("dwarf")), lines: ["For Stormwind.", "For {Area(1537)}.", "For the warm side of the fire?", "Now you're talking."]),
        (when: Idle, first: (temperament: Some("weary"), race: Some("human"), time_period: Some(Past)), second: (race: Some("dwarf")), lines: ["When this is done, come up to {Area(2017)}. My brother keeps the best inn on the square.", "{Area(2017)}. Aye. We'll see.", "You always say that."]),
        (when: Idle, first: (temperament: Some("weary"), race: Some("night_elf"), time_period: Some(Present)), second: (race: Some("gnome")), lines: ["{Area(141)} was never this hot.", "I could build you a little fan!", "Please do not."]),
        (when: Idle, first: (race: Some("gnome")), second: (race: Some("night_elf")), lines: ["Your moon's very bright tonight. Is it clockwork?", "It is Elune.", "So that's a no on the gears."]),
        (when: Idle, first: (race: Some("dwarf"), time_period: Some(Present)), second: (race: Some("dwarf")), lines: ["By Magni's beard, that's my mug.", "Your mug's empty.", "Because you've been drinking from it!"]),
        (when: Idle, first: (race: Some("night_elf")), second: (race: Some("night_elf")), lines: ["Ishnu-alah. You have not slept.", "Nor have you.", "Then let us not tell the others. They worry."]),

        // Idle: the Horde
        (when: Idle, first: (race: Some("troll"), time_period: Some(Present)), second: (race: Some("orc"), time_period: Some(Present)), lines: ["Da Darkspear owe Thrall a debt, mon.", "Thrall says friends keep no debts.", "Den I'll owe him quietly."]),
        (when: Idle, first: (race: Some("undead")), second: (race: Some("tauren")), lines: ["Do you ever think about what comes after?", "We return to the Earth Mother.", "I tried that. Someone else got to me first."]),
        (when: Idle, first: (race: Some("tauren")), second: (race: Some("undead")), lines: ["You took my blanket, friend.", "I don't feel the cold. I like how it smells of the living.", "Keep it, friend."]),
        (when: Idle, first: (race: Some("troll")), second: (race: Some("undead")), lines: ["Ya don't need to eat, mon?", "Need, no. Want, terribly.", "Dat's da saddest thing I heard all day."]),
        (when: Idle, first: (race: Some("undead")), second: (race: Some("undead")), lines: ["Do you remember Lordaeron?", "Every street. I lived on one.", "So did I. We might have been neighbours."]),
        (when: Idle, first: (race: Some("orc"), time_period: Some(Present)), second: (race: Some("tauren"), time_period: Some(Present)), lines: ["Thrall says the tauren taught us patience.", "We are still teaching, friend.", "And I am a slow student."]),
        (when: Idle, first: (temperament: Some("grim"), race: Some("orc"), time_period: Some(Present)), second: (race: Some("orc"), time_period: Some(Past)), lines: ["Which clan are you?", "Frostwolf. We kept to the high snows on Draenor.", "The Frostwolves are in Alterac now. Snow everywhere.", "Then nothing's changed."]),

        // Idle: the classes
        (when: Idle, first: (), second: (class: Some("hunter")), lines: ["Your pet sleeps on my bedroll.", "That's a great honour.", "It's a great deal of fur."]),
        (when: Idle, first: (class: Some("hunter")), second: (class: Some("druid")), lines: ["My cat won't stop staring at you.", "We have an understanding.", "What did you tell her?"]),
        (when: Idle, first: (class: Some("mage")), second: (class: Some("priest")), lines: ["Why do I own a sword?", "Same reason I own this mace. 'Just in case.'", "Has 'just in case' ever come?", "Never. Mine's very shiny."]),
        (when: Idle, first: (class: Some("warlock")), second: (class: Some("mage")), lines: ["Your frost leaves puddles in my tent.", "Your shadow bolts leave a smell in mine.", "Truce?", "Truce."]),
        (when: Idle, first: (class: Some("warlock")), second: (class: Some("paladin")), lines: ["Do you pray for me?", "Every night.", "Good. The imp says it itches."]),
        (when: Idle, first: (class: Some("mage")), second: (class: Some("warrior")), lines: ["Could you not stand where I'm aiming?", "That's where they are.", "That's rather my point."]),
        (when: Idle, first: (class: Some("rogue")), second: (), lines: ["Lovely ring.", "It was in my pack.", "Was it? Fancy that."]),
        (when: Idle, first: (class: Some("shaman")), second: (), lines: ["The spirits are restless tonight.", "That's my stomach.", "Then the spirits say feed it."]),
        (when: Idle, first: (), second: (class: Some("druid")), lines: ["Stop sniffing my tent.", "I was a bear. Bears sniff.", "You're not a bear now.", "Old habit."]),
        (when: Idle, first: (class: Some("warlock")), second: (), lines: ["Don't pet the imp.", "Does it bite?", "Worse. It talks, and it won't stop."]),
        (when: Idle, first: (), second: (race: Some("undead"), class: Some("paladin")), lines: ["Doesn't the Light burn you?", "Like a fever.", "Then why carry it?", "Because it still comes when I call."]),
        (when: Idle, first: (race: Some("gnome")), second: (race: Some("dwarf"), class: Some("shaman")), lines: ["Is that a totem or a mace?", "Aye.", "That's not an answer!", "The spirits took it as one."]),
        (when: Idle, first: (race: Some("dwarf")), second: (race: Some("human"), class: Some("hunter")), lines: ["A Stormwind hunter. Who taught you?", "A dwarf, in {Area(131)}.", "Then you were taught right."]),

        // Win: the camp has just cheered a zone won for the first time
        (when: Win, first: (temperament: Some("boisterous")), second: (temperament: Some("grim")), lines: ["{zone}! {hero} did it!", "They'll regroup.", "Then {hero} will do it again! Louder!"]),
        (when: Win, first: (temperament: Some("stalwart")), second: (), lines: ["{zone} is held.", "For tonight.", "Then we'll hold it again tomorrow."]),
        (when: Win, first: (temperament: Some("curious")), second: (temperament: Some("weary")), lines: ["{hero} came back from {zone} with mud I've never seen.", "Let {hero} sit down before you scrape it off.", "After, then. Just a little scrape."]),
        (when: Win, first: (temperament: Some("mischievous")), second: (temperament: Some("stalwart")), lines: ["I'll be telling everyone I was in {zone} too.", "You were in your tent.", "In spirit, I was in {zone}."]),
        (when: Win, first: (temperament: Some("devout")), second: (temperament: Some("grim")), lines: ["Something was watching over {hero} in {zone}.", "Something was. {hero} did the swinging."]),
        (when: Win, first: (temperament: Some("weary")), second: (temperament: Some("boisterous")), lines: ["{zone}'s done. Now I can sleep.", "Sleep? Tonight we dance!", "You dance. I'll sleep in your direction."]),
        (when: Win, first: (race: Some("dwarf")), second: (), lines: ["A round for {zone}! A round for {hero}!", "A round for the ale, more like.", "Aye! That too!"]),
        (when: Win, first: (race: Some("gnome")), second: (race: Some("dwarf")), lines: ["By my calculations, {zone} couldn't be done.", "Aye. {hero} didn't do your calculations.", "I'll do them again."]),
        (when: Win, first: (race: Some("human")), second: (race: Some("night_elf")), lines: ["{zone}! For Stormwind!", "For all of us. Stormwind may borrow it.", "Fair enough."]),
        (when: Win, first: (race: Some("orc")), second: (), lines: ["Lok'tar ogar! {zone} is ours!", "Till they come back.", "Then we take it again, and the song gets longer!"]),
        (when: Win, first: (race: Some("tauren")), second: (race: Some("troll")), lines: ["The Earth Mother walked with {hero} in {zone}.", "And da loa laughed all the way, mon.", "Then everyone is happy tonight."]),
        (when: Win, first: (race: Some("undead")), second: (), lines: ["{zone} is quiet now. I almost miss the screaming.", "You don't.", "No. But it seemed polite to say."]),
        (when: Win, first: (temperament: Some("mischievous"), race: Some("troll")), second: (), lines: ["I bet against {hero} in {zone}, mon.", "You what?", "So I'd have somethin' to cheer either way."]),

        // Loss: the played hero was overrun and is back; gentle
        (when: Loss, first: (temperament: Some("stalwart")), second: (temperament: Some("devout")), lines: ["{zone} pushed {hero} back.", "{hero}'s still in one piece.", "Then {hero} goes again."]),
        (when: Loss, first: (temperament: Some("boisterous")), second: (temperament: Some("grim")), lines: ["Ha! {hero} made {zone} work for it!", "{zone} still won.", "Today it did! Wait till {hero} gets another go at it!"]),
        (when: Loss, first: (temperament: Some("weary")), second: (), lines: ["Overrun?", "Overrun.", "Get the kettle on. {hero} will want something hot."]),
        (when: Loss, first: (temperament: Some("curious")), second: (temperament: Some("stalwart")), lines: ["What got {hero}, do you think?", "They got in too close.", "Then {hero} keeps them further off next time."]),
        (when: Loss, first: (temperament: Some("mischievous")), second: (temperament: Some("stalwart")), lines: ["Shall we tell {hero} we saw?", "No.", "Right. We saw nothing. Nice weather in {zone}, I hear."]),
        (when: Loss, first: (temperament: Some("devout")), second: (temperament: Some("grim")), lines: ["Something brought {hero} back.", "Something let {hero} get overrun.", "And brought {hero} home again. I'm thankful for that much."]),
        (when: Loss, first: (temperament: Some("grim")), second: (temperament: Some("boisterous")), lines: ["Overrun in {zone}. I said it was a bad idea.", "You say that about breakfast!", "And I'm usually right about breakfast."]),
        (when: Loss, first: (race: Some("dwarf")), second: (), lines: ["Get {hero} a drink. Get me one for the worry.", "You weren't worried.", "I'm worried I'll not get a drink."]),
        (when: Loss, first: (race: Some("gnome")), second: (race: Some("dwarf")), lines: ["New theory: {zone} cheats.", "Aye. That's been my theory all along."]),
        (when: Loss, first: (race: Some("human")), second: (race: Some("night_elf")), lines: ["They got {hero}.", "For a night. I have seen worse nights.", "You've seen worse everything."]),
        (when: Loss, first: (race: Some("tauren")), second: (), lines: ["The Earth Mother caught {hero} again.", "She has quick hands.", "She has had practice with all of us."]),
        (when: Loss, first: (race: Some("orc")), second: (race: Some("troll")), lines: ["{hero} fell back from {zone} with honour.", "And wit' every limb, mon. Even better."]),
        (when: Loss, first: (race: Some("undead")), second: (), lines: ["They got {hero}. Tiresome, isn't it, coming back?", "Is it?", "No. It's the best part. Don't tell anyone."]),
    ],
)
