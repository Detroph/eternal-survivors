    (id: "albino_snapjaw",      name: "Albino Snapjaw",      icon: "INV_Egg_03", look: Pet(npc: 14633), scale: 1.0, price: 30, text: "Pale as sea foam and twice as hard to catch."),
    (id: "hawksbill_snapjaw",   name: "Hawksbill Snapjaw",   icon: "INV_Egg_03", look: Pet(npc: 14632), scale: 1.0, price: 30, text: "A beak like a hawk and a pace like the tide."),
    (id: "leatherback_snapjaw", name: "Leatherback Snapjaw", icon: "INV_Egg_03", look: Pet(npc: 14630), scale: 1.0, price: 30, text: "Carries its own armour and never complains about the weight."),
    (id: "loggerhead_snapjaw",  name: "Loggerhead Snapjaw",  icon: "INV_Egg_02", look: Pet(npc: 14629), scale: 1.0, price: 30, text: "Old enough to remember the Caverns before the bronze dragons came, and in no hurry to leave."),
    (id: "olive_snapjaw",       name: "Olive Snapjaw",       icon: "INV_Egg_02", look: Pet(npc: 14631), scale: 1.0, price: 30, text: "Green as the beach grass it hatched under."),
