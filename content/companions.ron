    (id: "blue_baby_murloc",   name: "Blue Baby Murloc",   icon: "INV_Egg_03", look: Pet(npc: 15186), scale: 1.0, price: 30, text: "Gurgles happily at every tide pool and every coin."),
    (id: "orange_baby_murloc", name: "Orange Baby Murloc", icon: "INV_Egg_03", look: Pet(npc: 15361), scale: 1.0, price: 30, text: "A rare colour for a little fish-folk, and it knows it."),
    (id: "pink_baby_murloc",   name: "Pink Baby Murloc",   icon: "INV_Egg_03", look: Pet(npc: 16069), scale: 1.0, price: 30, text: "Bright pink and proud of it, whatever the shoal says."),
    (id: "white_baby_murloc",  name: "White Baby Murloc",  icon: "INV_Egg_03", look: Pet(npc: 16445), scale: 1.0, price: 30, text: "Pale as winter surf, and gurgling about it constantly."),
    (id: "purple_baby_murloc", name: "Purple Baby Murloc", icon: "INV_Egg_03", look: Creature(display: 15397), scale: 1.0, price: 30, text: "No other timeline has one. It would like to keep it that way."),
    // Mechanical pets
    (id: "mechanical_squirrel", name: "Mechanical Squirrel", icon: "INV_Crate_01", look: Pet(npc: 2671), scale: 1.0, price: 30, text: "Built from a tinker's blueprint, with acorns swapped for coins."),
    (id: "mechanical_chicken",  name: "Mechanical Chicken",  icon: "Spell_Magic_PolymorphChicken", look: Pet(npc: 8376), scale: 1.0, price: 30, text: "A homing robot that got lost in three different ages and found its way back each time."),
    (id: "mechanical_toad",     name: "Lifelike Mechanical Toad", icon: "INV_Misc_MonsterHead_03", look: Pet(npc: 12419), scale: 1.0, price: 30, text: "Lifelike enough to fool a fly, and very nearly you."),
    (id: "mechanical_yeti",     name: "Tranquil Mechanical Yeti", icon: "Ability_Hunter_Pet_Gorilla", look: Pet(npc: 15699), scale: 1.0, price: 30, text: "Wound up by a mountain-town tinker and told to relax."),
    (id: "walking_bomb",        name: "Tiny Walking Bomb",   icon: "INV_Misc_Bomb_04", look: Pet(npc: 9656), scale: 1.0, price: 30, text: "A tinker's leftovers on two legs. Keep it from the fire."),
