// The legendary amulets' looks: each legendary's signature moments
// wear a 1.12 spell look of their own, the boss's or hero's own look where the player's client
// has it, the class fantasy kept. A legendary is named by its main spell (as in
// legendary_amulets.ron); each moment is a milestone kind (Burst, LeaveArea, Spree...) or, for an
// Afflict, the effect it puts on an enemy (Stun, Fear, Silence...), with the Spell.dbc id it shows.
// As the content loads, each look goes into the matching milestones of that legendary, over any
// look legendary_amulets.ron gives them; numbers and words stay in legendary_amulets.ron.
// A legendary may list its looks drawn smaller (small: a rank of the spell no hero casts, styled at
// 0.6) and those that pulse on an enemy (pulsing: played again every 2 sec while the effect
// lasts). How each kind shows: docs/game/screens.md "Looks". The ids are pointers
// only.
([
    // ---- Warrior ----
    // Gruul's Shatter: turned to stone (a basilisk's Petrify), then shattering into rock
    (legendary: "slam", moments: [(Stun, 11020), (Burst, 26271)]),
    // Blademaster's Bladestorm: the Bladestorm whirl round the hero while it spins
    (legendary: "whirlwind", moments: [(Spree, 9632)]),
    // Mark of the Fallen Champion: a blood-red mark on each attacker
    (legendary: "revenge", moments: [(MarkAttackers, 1130)]),
    // Hateful Strike: Patchwerk's own blow on the healthiest
    (legendary: "cleave", moments: [(StrikeOne, 28308)]),
    // Hammer of the Mountain King: the Storm Bolt hammer flies at the healthiest
    (legendary: "thunder_clap", moments: [(StrikeOne, 20685)]),
    // Blade Dance: a cleaving slash on each enemy it dances to
    (legendary: "mortal_strike", moments: [(ExtraTargets, 9633)]),
    // Gorehowl: Bloodlust while the kills stack
    (legendary: "execute", moments: [(TimedBuff, 6742)]),
    // Bellowing Roar: Onyxia's roar of fear on each enemy; exposed: Sunder Armor's purple strike, small, pulsing while it lasts
    (legendary: "demo_shout", moments: [(Fear, 18431), (Vulnerable, 7405)], small: [7405], pulsing: [7405]),
    // Endurance Aura: an aura's ring at the hero's feet while the shout lasts; each blow landing again: a smaller heroic strike on the enemy hit
    (legendary: "battle_shout", moments: [(WhileBuff, 7069), (StrikeAgain, 284)], small: [284]),
    // Vampiric Bite: the vampiric embrace on each heal, a frenzy's red while it stacks
    (legendary: "bloodthirst", moments: [(HealOnTrigger, 15290), (TimedBuff, 26041)]),
    // Corrupted Blood: Hakkar's blood bursting on each enemy it passes to
    (legendary: "rend", moments: [(DotSpread, 24328)]),
    // Storm Bolt: the Mountain King's hammer at each further enemy
    (legendary: "shield_slam", moments: [(ExtraTargets, 20685)]),

    // ---- Paladin ----
    // Reflective Shield: a holy nova where the hero stands as the shield ends
    (legendary: "holy_shield", moments: [(Burst, 15237)]),
    // The Ashbringer: a great holy burst at the struck enemy
    (legendary: "seal_of_command", moments: [(Burst, 8913)]),
    // Sanctified Ground: Death and Decay's ground, recoloured holy gold, as Consecration grows
    (legendary: "consecration", moments: [(GrowingArea, 11433)]),
    // Hand of Ragnaros: a meteor falling on the struck enemy
    (legendary: "hammer_of_wrath", moments: [(Burst, 24340)]),
    // Avatar of the Light: a holy shield's glow at the feet while Divine Shield lasts, a holy nova as it ends and heals
    (legendary: "divine_shield", moments: [(WhileBuff, 11011), (HealOnTrigger, 15237)]),

    // ---- Hunter ----
    // Rocket Strike: Hunter's Mark on the enemy while the rocket comes, then a rocket's blast at the struck spot
    (legendary: "explosive_shot", moments: [(Burst, 1940), (BurstMark, 14323)]),
    // Serpent's Brood: the snakes hatch from a burst of green
    (legendary: "serpent_sting", moments: [(PetOnTrigger, 6587)]),
    // Lava Bomb: heated, burning ground
    (legendary: "explosive_trap", moments: [(LeaveArea, 22191)]),
    // Silence: the silencing hush on the enemy; exposed: Sunder Armor's purple strike, small, pulsing while it lasts
    (legendary: "concussive_shot", moments: [(Silence, 15487), (Vulnerable, 7405)], small: [7405], pulsing: [7405]),
    // Lava Splash: Emberseer's great fire burst where the enemy dies
    (legendary: "immolation_trap", moments: [(ExplodeOnDeath, 16049)]),
    // Flash Freeze: frozen solid in ice (Sapphiron's Icebolt); exposed: Sunder Armor's purple strike, small, pulsing while it lasts
    (legendary: "frost_trap", moments: [(Stun, 28522), (Vulnerable, 7405)], small: [7405], pulsing: [7405]),

