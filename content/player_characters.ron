// Hand-made player characters, one by one. Bosses played
// by one (`played_by: Some(Any)` or `Some(Named("<id>"))`) take a character of the faction the
// heroes fight, and later mechanics will draw from here too.
//
// Each character:
//   (
//       id: "grubgrub",                  // its own id
//       name: "Grubgrub",
//       race: "orc", class: "warrior",   // ids in races.ron and classes.ron (any pair our game allows)
//       gender: Male,                    // or Female
//       form: Some(Cat),                 // optional: shown in a druid's form (Cat, Bear or Moonkin)
//       looks: Some((skin: 1, face: 2, hair_style: 3, hair_color: 4, facial_hair: 5)),
//                                        // (left out: a face picked each time it shows)
//       yell: "For the Horde!",          // what it yells as it arrives (as a boss, or assisting)
//       death_yell: "Bye!",              // optional: what it yells as it dies (as a boss, or ending its assist)
//       boss_spell: Some(133),           // optional: what it casts from range as a boss, in place of its class's
//       boss_abilities: [Stomp(look_spell: 6572)], // optional: its boss abilities, in place of its class's (pvp_looks.ron)
//       assist: "...",                   // how it assists a hero, described (the mechanic to come);
//                                        // it lasts at most 10 sec unless the description gives a time
//       gear: Random,                    // its class's PvP looks, or:
//       // gear: Picked((
//       //     armor: [(slot: Head, display: 12345), (slot: Chest, display: 23456, robe: true)],
//       //     main_hand: Some((kind: TwoHandedAxe, display: 34567)),
//       //     off_hand: None,
//       //     ranged: Some((kind: Bow, display: 45678)),
//       // )),                             // a slot left out takes its class's PvP looks
//   ),
