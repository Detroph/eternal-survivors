    bosses: [
        (
            name: "Kurinnaxx",
            display_id: 15742,
            scale: 0.65,
            creature_type: Beast,
            spawn_minute: 4.0,
            yell: "The ground splits as something huge bursts from the sand!",
            // each blow stacks a Mortal Wound on the hero standing at him (damage only)
            on_hit: Some((look_spell: 25646, damage_mult: 0.05, every: 1.0, seconds: 10.0, max_stacks: 5)),
            abilities: [
                // sand traps open under the hero: a marked vortex that stays a while
                Marked(
                    shape: Circle(radius: 4.0),
                    at: Hero,
                    impact_spell: 0,
                    damage_mult: Some(1.0),
                    wind_up: Some(1.5),
                    cooldown: Some(9.0),
                    leaves: Some((look_spell: 25160, radius: 4.0, seconds: 12.0, damage_mult: 0.3)),
                    warn: Some((text: "Sand trap under you: move!", icon_spell: Some(25160), bar: Some("Sand trap"))),
                ),
            ],
            script: [
                // 30 %: he enrages
                (
                    on: Health(30.0),
                    warn: Some((text: "Kurinnaxx enrages!", colour: Purple, icon_spell: Some(26527))),
                    soon: Some("{Spell(26527)} soon"),
                    run: [Enrage, Emote(text: "%s becomes enraged!")],
                ),
            ],
            is_final: false,
        ),
        (
            name: "General Rajaxx",
            display_id: 15376,
            scale: 1.35,
            creature_type: Humanoid,
            spawn_minute: 8.0,
            yell: "Soon you will know the price of your meddling, mortals... The master is nearly whole... And when he rises, your world will cease.",
            swing_mult: Some(2.0),
            abilities: [
                // Thundercrash: a big marked circle round him
                Marked(
                    shape: Circle(radius: 15.0),
                    at: Boss,
                    impact_spell: 25599,
                    wind_up: Some(2.5),
                    cooldown: Some(12.0),
                    warn: Some((text: "{Spell(25599)}: run far from him!", bar: Some("{Spell(25599)}"))),
                ),
            ],
            script: [
                // the gate's waves first, each led by a captain; then he joins
                (
                    on: Arrival,
                    run: [
                        Waves(
                            waves: [
                                (
                                    run: [Wave(enemy: "Captain Qeez", count: 1, at: Ring(6.0)), Wave(enemy: "Qiraji Warrior", count: 3, at: Ring(7.0)), Wave(enemy: "Swarmguard Needler", count: 3, at: Ring(7.0))],
                                    warn: Some((text: "Wave 1: Captain Qeez!", colour: Orange)),
                                ),
                                (
                                    run: [
                                        Yell(text: "Fandral! Your time has come! Go and hide in the Emerald Dream and pray we never find you!", sound: Some(8641)),
                                        Wave(enemy: "Captain Tuubid", count: 1, at: Ring(6.0)), Wave(enemy: "Qiraji Warrior", count: 3, at: Ring(7.0)), Wave(enemy: "Swarmguard Needler", count: 3, at: Ring(7.0)),
                                    ],
                                    warn: Some((text: "Wave 2: Captain Tuubid!", colour: Orange)),
                                ),
                                (
                                    run: [
                                        Yell(text: "Staghelm will whimper and beg for his life, just as his whelp of a son did! One thousand years of injustice will end this day!", sound: Some(8642)),
                                        Wave(enemy: "Captain Drenn", count: 1, at: Ring(6.0)), Wave(enemy: "Qiraji Warrior", count: 3, at: Ring(7.0)), Wave(enemy: "Swarmguard Needler", count: 3, at: Ring(7.0)),
                                    ],
                                    warn: Some((text: "Wave 3: Captain Drenn!", colour: Orange)),
                                ),
                                (
                                    run: [
                                        Yell(text: "Fear is for the enemy! Fear and death!", sound: Some(8643)),
                                        Wave(enemy: "Captain Xurrem", count: 1, at: Ring(6.0)), Wave(enemy: "Qiraji Warrior", count: 3, at: Ring(7.0)), Wave(enemy: "Swarmguard Needler", count: 3, at: Ring(7.0)),
                                    ],
                                    warn: Some((text: "Wave 4: Captain Xurrem!", colour: Orange)),
                                ),
                                (
                                    run: [
                                        Yell(text: "No longer will we wait behind barred doors and walls of stone! No longer will our vengeance be denied! The dragons themselves will tremble before our wrath!", sound: Some(8644)),
                                        Wave(enemy: "Major Yeggeth", count: 1, at: Ring(6.0)), Wave(enemy: "Qiraji Warrior", count: 3, at: Ring(7.0)), Wave(enemy: "Swarmguard Needler", count: 3, at: Ring(7.0)),
                                    ],
                                    warn: Some((text: "Wave 5: Major Yeggeth!", colour: Orange)),
                                ),
                                (
                                    run: [
                                        Yell(text: "The time of our retribution is at hand! Let darkness reign in the hearts of our enemies!", sound: Some(8645)),
                                        Wave(enemy: "Major Pakkon", count: 1, at: Ring(6.0)), Wave(enemy: "Qiraji Warrior", count: 3, at: Ring(7.0)), Wave(enemy: "Swarmguard Needler", count: 3, at: Ring(7.0)),
                                    ],
                                    warn: Some((text: "Wave 6: Major Pakkon!", colour: Orange)),
                                ),
                                (
                                    run: [Wave(enemy: "Colonel Zerran", count: 1, at: Ring(6.0)), Wave(enemy: "Qiraji Warrior", count: 4, at: Ring(7.0)), Wave(enemy: "Swarmguard Needler", count: 4, at: Ring(7.0))],
                                    warn: Some((text: "Wave 7: Colonel Zerran!", colour: Orange)),
                                ),
                            ],
                            gap: 20.0,
                            immune: true,
                            aloof: true,
                            bar: Some("Next wave"),
                            counter: Some("Qiraji left"),
                            then: [Yell(text: "Impudent fool! I will kill you myself!", sound: Some(8638))],
                        ),
                    ],
                ),
            ],
            is_final: false,
        ),
        (
            name: "Princess Huhuran",
            display_id: 15739,
            scale: 0.55,
            creature_type: Beast,
            spawn_minute: 12.0,
            yell: "The princess screeches and lashes out in a rage!",
            // each blow stacks her Acid Spit on the hero (damage only)
            on_hit: Some((look_spell: 26050, damage_mult: 0.05, every: 1.0, seconds: 10.0, max_stacks: 5)),
            abilities: [
                // poison bolt volleys
                Volley(look_spell: 26053, impact_on_bunny: true),
                // lasting poison clouds round the hero
                Marked(
                    shape: Circle(radius: 4.0),
                    at: NearHero(count: 2, spread: 9.0),
                    impact_spell: 0,
                    damage_mult: Some(1.0),
                    wind_up: Some(1.5),
                    cooldown: Some(12.0),
                    leaves: Some((look_spell: 23861, radius: 4.0, seconds: 15.0, damage_mult: 0.25)),
                    warn: Some((text: "Poison clouds: stay out of them!", colour: Green, icon_spell: Some(23861), bar: Some("Poison clouds"))),
                ),
            ],
            script: [
                // a frenzy now and then: her clouds come sooner and hit harder for 8 s
                (
                    on: Every(20.0),
                    warn: Some((text: "{Spell(26051)}: faster clouds for 8 s!", colour: Purple, icon_spell: Some(26051), bar: Some("{Spell(26051)}"))),
                    run: [
                        Emote(text: "%s goes into a killing frenzy!"),
                        Empower(look_spell: 26051, faster: 0.5, harder: 0.3, seconds: 8.0),
                    ],
                ),
                // 30 %: she goes berserk
                (
                    on: Health(30.0),
                    warn: Some((text: "Huhuran goes berserk!", colour: Purple, icon_spell: Some(26068))),
                    soon: Some("{Spell(26068)} soon"),
                    run: [Enrage, Emote(text: "%s goes into a berserker rage!")],
                ),
            ],
            is_final: false,
        ),
        (
            name: "Ossirian the Unscarred",
            display_id: 15432,
            scale: 0.90,
            creature_type: Humanoid,
            spawn_minute: 16.0,
            yell: "Sands of the desert, rise and block out the sun!",
            aggro_sound: Some(8598),
            swing_mult: Some(2.0),
            abilities: [
                // War Stomp round him
                Marked(
                    shape: Circle(radius: 10.0),
                    at: Boss,
                    impact_spell: 25188,
                    cooldown: Some(9.0),
                    warn: Some((text: "{Spell(25188)}: step back!", bar: Some("{Spell(25188)}"))),
                ),
                // sand tornadoes rise at him and wander after the hero
                Marked(
                    shape: Circle(radius: 3.0),
                    at: Boss,
                    impact_spell: 0,
                    damage_mult: Some(1.0),
                    wind_up: Some(1.2),
                    cooldown: Some(10.0),
                    leaves: Some((look_spell: 25160, radius: 3.0, seconds: 20.0, damage_mult: 0.3, drift: 2.5)),
                    warn: Some((text: "Sand tornado: keep away from it!", icon_spell: Some(25160), bar: Some("Tornado"))),
                ),
            ],
            script: [
                // Supreme: he takes almost nothing until the hero walks over a crystal, which
                // makes him weak for 30 s; another crystal comes up 35 s later
                (
                    on: Arrival,
                    run: [
                        Shield(damage_taken: 0.1, look_spell: 25176),
                        Place(
                            object: (
                                name: "Ossirian Crystal",
                                display_id: 6486,
                                scale: 1.0,
                                glow_spell: 20922,
                                on_contact: [Mortal(seconds: 30.0), Emote(text: "%s is weakened!")],
                                again_after: Some(35.0),
                                warn: Some((text: "A crystal is up: walk over it to weaken him!", colour: Yellow, icon_spell: Some(25177))),
                            ),
                            near: Hero(14.0),
                        ),
                    ],
                ),
            ],
            is_final: false,
        ),
        (
            name: "C'Thun",
            display_id: 15556,
            scale: 1.0,
            creature_type: NotSpecified,
            spawn_minute: 20.0,
            yell: "YOU ARE ALREADY DEAD.",
            aggro_sound: Some(8581),
            // the Eye creeps (it stands, nearly)
            move_speed: Some(3.0),
            swing_mult: Some(1.771),
            abilities: [
                // Dark Glare: a marked beam that, once it lands, sweeps slowly round him
                Marked(
                    shape: Line(length: 40.0, width: 6.0),
                    at: Boss,
                    impact_spell: 26029,
                    impact_on_bunny: true,
                    wind_up: Some(2.5),
                    damage_mult: Some(2.0),
                    cooldown: Some(30.0),
                    sweep: Some((turn: 25.0, seconds: 8.0, every: 0.5, damage_mult: 0.5, look_spell: 20924)),
                    warn: Some((text: "{Spell(26029)}: stay ahead of the beam!", colour: Purple, bar: Some("{Spell(26029)}"))),
                ),
                // Eye Beams chain from spot to spot round the hero
                Marked(
                    shape: Circle(radius: 3.0),
                    at: NearHero(count: 4, spread: 10.0),
                    impact_spell: 26134,
                    impact_on_bunny: true,
                    damage_mult: Some(1.0),
                    wind_up: Some(1.2),
                    chain: Some(0.5),
                    cooldown: Some(9.0),
                    warn: Some((text: "{Spell(26134)}: it chains, keep moving!", colour: Purple, bar: Some("{Spell(26134)}"))),
                ),
                // Eye Tentacles burst from marked spots
                Marked(
                    shape: Circle(radius: 3.0),
                    at: NearHero(count: 3, spread: 14.0),
                    impact_spell: 26262,
                    damage_mult: Some(1.0),
                    wind_up: Some(2.0),
                    cooldown: Some(20.0),
                    brings: Some((enemy: "Eye Tentacle", count: 1, rooted: true)),
                    warn: Some((text: "Eye Tentacles: kill them!", colour: Orange, icon_spell: Some(26143), bar: Some("Eye Tentacles"))),
                ),
            ],
            script: [
                // phase 2 at half health: his body rises, and claws and giants burst from marked
                // spots (no stomach)
                (
                    on: Health(50.0),
                    warn: Some((text: "C'Thun's body rises: tentacles from the ground!", colour: Purple, icon_spell: Some(26478))),
                    soon: Some("C'Thun's body soon"),
                    run: [
                        Emote(text: "The Eye falls, and C'Thun himself rises!"),
                        Look(display_id: 15787, scale: Some(0.35)),
                        Kit(abilities: [
                            Marked(
                                shape: Circle(radius: 3.5),
                                at: NearHero(count: 3, spread: 12.0),
                                impact_spell: 6524,
                                damage_mult: Some(1.5),
                                wind_up: Some(1.8),
                                cooldown: Some(12.0),
                                brings: Some((enemy: "Claw Tentacle", count: 1, rooted: true)),
                                warn: Some((text: "Claw Tentacles: move off the marks!", colour: Orange, icon_spell: Some(6524), bar: Some("Claw Tentacles"))),
                            ),
                            Marked(
                                shape: Circle(radius: 5.0),
                                at: Hero,
                                impact_spell: 6524,
                                damage_mult: Some(2.0),
                                wind_up: Some(2.0),
                                cooldown: Some(25.0),
                                brings: Some((enemy: "Giant Claw Tentacle", count: 1, rooted: true)),
                                warn: Some((text: "A giant tentacle: get off the mark!", colour: Orange, icon_spell: Some(6524), bar: Some("Giant tentacle"))),
                            ),
                            Marked(
                                shape: Circle(radius: 5.0),
                                at: NearHero(count: 1, spread: 12.0),
                                impact_spell: 6524,
                                damage_mult: Some(2.0),
                                wind_up: Some(2.0),
                                cooldown: Some(30.0),
                                brings: Some((enemy: "Giant Eye Tentacle", count: 1, rooted: true)),
                                warn: Some((text: "Giant Eye Tentacle: kill it!", colour: Orange, icon_spell: Some(26134), bar: Some("Giant Eye"))),
                            ),
                        ]),
                    ],
                ),
            ],
            is_final: true,
            health_share: Some(1.2), // lived 147 s against a 150 s goal, 124 s with the new formula
        ),
    ],
