            appears_at_minute: 1.0,
        ),
        (
            name: "Hakkari Shadowcaster",
            display_id: 314,
            scale: 1.0,
            creature_type: Humanoid,
            kind: Ranged,
            toughness: 0.5,
            appears_at_minute: 2.0,
            look_spell: Some(686),
        ),
        (
            name: "Gurubashi Axe Thrower",
            display_id: 316,
            scale: 1.0,
            creature_type: Humanoid,
            kind: Mid,
            toughness: 1.25,
