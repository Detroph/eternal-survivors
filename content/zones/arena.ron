// A zone: its arena, roster and boss schedule. The file name is the zone id.
// Zones are ordered by `difficulty`, ascending: that order is the unlock path and the order
// every list shows. Roster and ability numbers come from enemy_kinds.ron by kind.
(
    id: "arena",
    name: Area(1741),
    subtitle: "Blood in the Ring",
    description: "The trolls of {Area(19)} have taken the arena. Raptors, serpents and priests of the Blood God fill the pit.",
    map_id: 0,
    area_id: 33,
    spawn: (
        x: -13204.0,
        y: 274.0,
        z: 21.9,
        facing: 0.0,
    ),
    arena_radius: 38.0,
    enemy_spawn_ring: (30.0, 40.0),
    boss_spawn_ring: (25.0, 30.0),
    hour: 16,
    weather: (
        kind: None,
        intensity: 0.0,
    ),
    difficulty: 7.0,
    enemies: [
        (
            name: "Gurubashi Scout",
            display_id: 337,
            scale: 1.0,
            creature_type: Humanoid,
            kind: Fodder,
            toughness: 0.5,
            appears_at_minute: 0.0,
        ),
        (
