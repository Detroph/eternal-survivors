    bosses: [
        (
            name: "General Angerforge",
            display_id: 8756,
            // vmangos's creature of this name holds these (docs/game/enemy-weapons.md)
            weapons: (
                main_hand: Some((kind: TwoHandedAxe, display: 21238, inventory_type: 17, sheath: 1, material: 1)),
            ),
            scale: 3.15,
            creature_type: Humanoid,
            spawn_minute: 4.0,
            yell: "Intruders! Every hammer to the gate!",
            swing_mult: Some(2.0),
            abilities: [
                // Flurry: a burst of blows in front of him
                Marked(
                    shape: Cone(length: 10.0, angle: 90.0),
                    at: Boss,
                    impact_spell: 15754,
                    wind_up: Some(1.3),
                    cooldown: Some(8.0),
                    warn: Some((text: "{Spell(15088)}: get out of the front!", icon_spell: Some(15088), bar: Some("{Spell(15088)}"))),
                ),
            ],
            script: [
                // at 30 % (as the original) he calls his Reservists and two Medics
                (
                    on: Health(30.0),
                    warn: Some((text: "Reservists and Medics: kill the Medics!", colour: Orange)),
                    soon: Some("Reservists soon"),
                    run: [
                        Emote(text: "%s cries out an alarm!"),
                        Wave(enemy: "Anvilrage Reservist", count: 8, at: Edges),
                        Wave(enemy: "Anvilrage Medic", count: 2, at: Ring(8.0)),
                    ],
                ),
                // the Medics heal him while they live
                (
                    on: Every(5.0),
                    run: [Mend(by: "Anvilrage Medic", share: 0.01, look_spell: 15586)],
                ),
            ],
            is_final: false,
        ),
        (
            name: "Warchief Rend Blackhand",
            display_id: 9778,
            // vmangos's creature of this name holds these (docs/game/enemy-weapons.md)
            weapons: (
                main_hand: Some((kind: Polearm, display: 22411, inventory_type: 17, sheath: 2, material: 1)),
            ),
            scale: 2.35,
            creature_type: Humanoid,
            spawn_minute: 8.0,
            yell: "Blackrock stands! You do not!",
            swing_mult: Some(2.0),
            // on Gyth: his flame breath, a cone that leaves fire
            abilities: [
                Marked(
                    shape: Cone(length: 16.0, angle: 60.0),
                    at: Boss,
                    impact_spell: 16390,
                    cooldown: Some(9.0),
                    leaves: Some((look_spell: 2120, radius: 3.0, seconds: 8.0, damage_mult: 0.25)),
                    warn: Some((text: "{Spell(16390)}: get out of the cone!", bar: Some("{Spell(16390)}"))),
                ),
            ],
            script: [
                // the Spire's waves first, Rend watching; then he comes down on Gyth
                (
                    on: Arrival,
                    run: [
                        Waves(
                            waves: [
                                (
                                    run: [Wave(enemy: "Chromatic Whelp", count: 5, at: Ring(6.0)), Wave(enemy: "Blackhand Dragon Handler", count: 1, at: Ring(6.0))],
                                    warn: Some((text: "The Spire's defenders: wave 1!", colour: Orange)),
                                ),
                                (
                                    run: [Wave(enemy: "Blackrock Grunt", count: 4, at: Ring(6.0)), Wave(enemy: "Chromatic Dragonspawn", count: 1, at: Ring(6.0))],
                                    warn: Some((text: "Wave 2!", colour: Orange)),
                                ),
                                (
                                    run: [Wave(enemy: "Chromatic Whelp", count: 5, at: Ring(6.0)), Wave(enemy: "Blackhand Dragon Handler", count: 2, at: Ring(6.0))],
                                    warn: Some((text: "Wave 3!", colour: Orange)),
                                ),
                                (
                                    run: [Wave(enemy: "Chromatic Dragonspawn", count: 2, at: Ring(6.0)), Wave(enemy: "Blackhand Dragon Handler", count: 2, at: Ring(6.0))],
                                    warn: Some((text: "Wave 4!", colour: Orange)),
                                ),
                                (
                                    run: [
                                        Wave(enemy: "Chromatic Whelp", count: 6, at: Ring(6.0)),
                                        Wave(enemy: "Chromatic Dragonspawn", count: 2, at: Ring(6.0)),
                                        Wave(enemy: "Blackhand Dragon Handler", count: 1, at: Ring(6.0)),
                                    ],
                                    warn: Some((text: "Last wave!", colour: Orange)),
                                ),
                            ],
                            gap: 30.0,
                            immune: true,
                            aloof: true,
                            bar: Some("Next wave"),
                            counter: Some("Defenders left"),
                            then: [
                                Yell(text: "With pleasure..."),
                                Emote(text: "%s comes down on Gyth!"),
                                // Gyth (the drake with its rider) sized to the boss-sized Rend: his size kept in step with Rend's
                                // (2.5 for his former 3.04)
                                Look(display_id: 9723, scale: Some(1.95)),
                            ],
                        ),
                    ],
                ),
                // 50 %: knocked off his drake, he fights on foot with Whirlwind and his cleave
                (
                    on: Health(50.0),
                    warn: Some((text: "Knocked off his drake: beware his {Spell(13736)}!", colour: Purple, icon_spell: Some(13736))),
                    soon: Some("Off the drake soon"),
                    run: [
                        Emote(text: "%s is knocked off his drake!"),
                        Look(display_id: 9778, scale: Some(2.35)),
                        Kit(abilities: [
                            // Whirlwind: a circle round him that follows him for 6 s
                            Zone(
                                zone: (look_spell: 13736, radius: 7.0, seconds: 6.0, damage_mult: 0.5, follows: true),
                                at: Boss,
                                cooldown: Some(14.0),
                                warn: Some((text: "{Spell(13736)}: run from him!", bar: Some("{Spell(13736)}"))),
                            ),
                            Marked(
                                shape: Cone(length: 8.0, angle: 90.0),
                                at: Boss,
                                impact_spell: 15754,
                                wind_up: Some(1.2),
                                cooldown: Some(8.0),
                                warn: Some((text: "{Spell(15754)}: get out of the front!", bar: Some("{Spell(15754)}"))),
                            ),
                        ]),
                    ],
                ),
