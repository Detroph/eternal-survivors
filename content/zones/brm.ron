        ),
        (
            name: "Emperor Dagran Thaurissan",
            display_id: 8807,
            // vmangos's creature of this name holds these (docs/game/enemy-weapons.md)
            weapons: (
                main_hand: Some((kind: OneHandedMace, display: 21751, inventory_type: 13, sheath: 3, material: 2)),
            ),
            scale: 3.15,
            creature_type: Humanoid,
            spawn_minute: 12.0,
            yell: "Come to the aid of the Throne!",
            swing_mult: Some(1.771),
            abilities: [
                // Avatar of Flame: a ring of fire round him, safe at his feet
                Marked(
                    shape: Ring(inner: 4.0, outer: 13.0),
                    at: Boss,
                    impact_spell: 15636,
                    cooldown: Some(11.0),
                    warn: Some((text: "{Spell(15636)}: hug him or get clear!", bar: Some("{Spell(15636)}"))),
                ),
                // Hand of Thaurissan: his hammer flies at the hero's spot
                Marked(
                    shape: Circle(radius: 4.0),
                    at: Hero,
                    impact_spell: 17492,
                    impact_on_bunny: true,
                    missile: true,
                    wind_up: Some(2.0),
                    cooldown: Some(8.0),
                    warn: Some((text: "{Spell(17492)}: move!", bar: Some("{Spell(17492)}"))),
                ),
            ],
            script: [
                // Princess Moira comes with him and heals him: kill her or burst through
                (
                    on: Arrival,
                    warn: Some((text: "Princess Moira heals him: kill her or burst through!", colour: Yellow, icon_spell: Some(15586))),
                    run: [Wave(enemy: "Princess Moira Bronzebeard", count: 1, at: Ring(6.0))],
                ),
                (
                    on: Every(6.0),
                    run: [Mend(by: "Princess Moira Bronzebeard", share: 0.02, look_spell: 15586)],
                ),
            ],
            is_final: false,
        ),
        (
            name: "Majordomo Executus",
            display_id: 12029,
            // vmangos's creature of this name holds these (docs/game/enemy-weapons.md)
            weapons: (
                main_hand: Some((kind: Polearm, display: 22031, inventory_type: 17, sheath: 2, material: 1)),
            ),
            scale: 2.35,
            creature_type: Humanoid,
            spawn_minute: 16.0,
            yell: "Reckless mortals! None may challenge the Sons of the Living flame!",
            aggro_sound: Some(8035),
            swing_mult: Some(1.5),
            abilities: [
                Volley(look_spell: 133, impact_on_bunny: true),
                // flames at the hero's feet (his teleport's fire)
                Marked(
                    shape: Circle(radius: 4.0),
                    at: Hero,
                    impact_spell: 20618,
                    wind_up: Some(1.5),
                    cooldown: Some(9.0),
                    warn: Some((text: "Flames at your feet: move!", icon_spell: Some(20618), bar: Some("Flames"))),
                ),
            ],
            script: [
                // immune until all eight Flamewakers are dead
                (
                    on: Arrival,
                    run: [
                        Waves(
                            waves: [
                                (
                                    run: [Wave(enemy: "Flamewaker Elite", count: 4, at: Ring(7.0)), Wave(enemy: "Flamewaker Healer", count: 4, at: Ring(7.0))],
                                    warn: Some((text: "Majordomo is immune: kill his eight guards!", colour: Orange, icon_spell: Some(20620))),
                                ),
                            ],
                            immune: true,
                            look_spell: 20620,
                            counter: Some("Guards left"),
                            then: [
                                Yell(text: "You think you've won already? Perhaps you'll need another lesson in pain!"),
                                Emote(text: "%s is no longer protected!"),
                            ],
                        ),
                    ],
                ),
                // beaten, he submits; Ragnaros rises for one marked Sulfuras smash, then sinks
                (
                    on: Death,
                    run: [
                        Yell(text: "Impossible! Stay your attack, mortals... I submit! I submit!", sound: Some(8038)),
                        Cameo(
                            enemy: "Ragnaros",
                            // further out at his full size, so he rises clear of the fight
                            at: Ring(16.0),
                            delay: 4.0,
                            seconds: 8.0,
                            rise_spell: 20568,
                            sink_spell: 19774,
                            run: [Yell(text: "TOO SOON! YOU HAVE AWAKENED ME TOO SOON, EXECUTUS! WHAT IS THE MEANING OF THIS INTRUSION???", sound: Some(8043))],
                            abilities: [
                                Marked(
                                    shape: Circle(radius: 9.0),
                                    at: Hero,
                                    impact_spell: 20566,
                                    wind_up: Some(2.0),
                                    cooldown: Some(6.0),
                                    warn: Some((text: "Sulfuras comes down: get out!", icon_spell: Some(20566), bar: Some("Sulfuras"))),
                                ),
                            ],
                        ),
                    ],
                ),
            ],
            is_final: false,
        ),
        (
            name: "Nefarian",
            display_id: 11380,
            scale: 1.5,
            creature_type: Dragonkin,
            spawn_minute: 20.0,
            yell: "Let the games begin!",
            aggro_sound: Some(8280),
            swing_mult: Some(1.5),
            abilities: [
                Volley(look_spell: 686, impact_on_bunny: true),
                // Shadow Flame: a cone in front of him
                Marked(
                    shape: Cone(length: 20.0, angle: 60.0),
                    at: Boss,
                    impact_spell: 22539,
                    wind_up: Some(1.6),
                    cooldown: Some(10.0),
                    warn: Some((text: "{Spell(22539)}: get out of the cone!", bar: Some("{Spell(22539)}"))),
                ),
            ],
            script: [
                // phase 1: drakonid waves while he watches; phase 2: he lands
                (
                    on: Arrival,
                    run: [
                        Waves(
                            waves: [
                                (
                                    run: [Wave(enemy: "Red Drakonid", count: 3, at: Edges), Wave(enemy: "Blue Drakonid", count: 3, at: Edges)],
                                    warn: Some((text: "Drakonids: wave 1!", colour: Orange)),
                                ),
                                (
                                    run: [Wave(enemy: "Green Drakonid", count: 3, at: Edges), Wave(enemy: "Bronze Drakonid", count: 3, at: Edges)],
                                    warn: Some((text: "Drakonids: wave 2!", colour: Orange)),
                                ),
                                (
                                    run: [Wave(enemy: "Black Drakonid", count: 3, at: Edges), Wave(enemy: "Red Drakonid", count: 2, at: Edges), Wave(enemy: "Chromatic Drakonid", count: 1, at: Edges)],
                                    warn: Some((text: "Drakonids: wave 3!", colour: Orange)),
                                ),
                                (
                                    run: [Wave(enemy: "Blue Drakonid", count: 2, at: Edges), Wave(enemy: "Green Drakonid", count: 2, at: Edges), Wave(enemy: "Chromatic Drakonid", count: 2, at: Edges)],
                                    warn: Some((text: "Drakonids: last wave!", colour: Orange)),
                                ),
                            ],
                            gap: 25.0,
                            immune: true,
                            aloof: true,
                            bar: Some("Next drakonids"),
                            counter: Some("Drakonids left"),
                            then: [
                                Yell(text: "Well done, my minions. The mortals' courage begins to wane! Now, let's see how they contend with the true Lord of Blackrock Spire!!!", sound: Some(8288)),
                                Emote(text: "%s lands!"),
                            ],
                        ),
                    ],
                ),
                // every 30 s a class call twists the hero's class for 10 s (never crowd control;
                // unvoiced in 1.12: text only)
                (
                    on: Every(30.0),
                    warn: Some((text: "Class call!", colour: Purple, icon_spell: Some(23410), bar: Some("Class call"))),
                    run: [
                        ClassCall(
                            seconds: 10.0,
                            calls: [
                                (class: "warrior", weakens: 0.5, look_spell: 23397, warn: (text: "{Class(1)} call: your blows go wild, half damage for 10 s!", colour: Purple), run: [Yell(text: "Warriors, I know you can hit harder than that! Lets see it!")]),
                                (class: "paladin", weakens: 0.5, look_spell: 23418, warn: (text: "{Class(2)} call: your blessings feed him, half damage for 10 s!", colour: Purple), run: [Yell(text: "Paladins... I've heard you have many lives. Show me.")]),
                                (class: "hunter", weakens: 0.5, look_spell: 23436, warn: (text: "{Class(3)} call: your weapon is corrupted, half damage for 10 s!", colour: Purple), run: [Yell(text: "Hunters and your annoying pea-shooters!")]),
                                (class: "rogue", weakens: 0.5, look_spell: 23414, warn: (text: "{Class(4)} call: dragged into the light, half damage for 10 s!", colour: Purple), run: [Yell(text: "Rogues? Stop hiding and face me!")]),
                                (class: "priest", weakens: 0.5, look_spell: 23401, warn: (text: "{Class(5)} call: your light is corrupted, half damage for 10 s!", colour: Purple), run: [Yell(text: "Priests! If you're going to keep healing like that, we might as well make it a little more interesting!")]),
                                (class: "shaman", weakens: 0.5, look_spell: 23425, warn: (text: "{Class(7)} call: your totems are corrupted, half damage for 10 s!", colour: Purple), run: [Yell(text: "Shamans, show me what your totems can do!")]),
                                (class: "mage", weakens: 0.5, look_spell: 23410, warn: (text: "{Class(8)} call: your magic runs wild, half damage for 10 s!", colour: Purple), run: [Yell(text: "Mages too? You should be more careful when you play with magic...")]),
                                (class: "warlock", look_spell: 23427, warn: (text: "{Class(9)} call: infernals rise round you!", colour: Orange), run: [Yell(text: "Warlocks, you shouldn't be playing with magic you don't understand. See what happens?"), Wave(enemy: "Corrupted Infernal", count: 3, at: NearHero(7.0))]),
                                (class: "druid", weakens: 0.5, look_spell: 23398, warn: (text: "{Class(11)} call: forced into another shape, half damage for 10 s!", colour: Purple), run: [Yell(text: "Druids and your silly shapeshifting. Lets see it in action!")]),
