// A zone: its arena, roster and boss schedule. The file name is the zone id.
// Zones are ordered by `difficulty`, ascending: that order is the unlock path and the order
// every list shows. Roster and ability numbers come from enemy_kinds.ron by kind.
(
    id: "elwynn",
    name: Area(12),
    subtitle: "Trouble at the Mine",
    description: "Kobolds swarm out of the hills, gnolls raid the riverbanks and the Defias rise in the fields. Hold out until their leader shows himself.",
    map_id: 0,
    area_id: 12,
    // Northshire Valley.
    spawn: (
        x: -8776.9,
        y: -116.82,
