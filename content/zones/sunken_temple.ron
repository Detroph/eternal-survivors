// A zone: its arena, roster and boss schedule. The file name is the zone id.
// Zones are ordered by `difficulty`, ascending: that order is the unlock path and the order
// every list shows. Roster and ability numbers come from enemy_kinds.ron by kind.
(
    // The Sunken Temple took the fifth zone's place from Arathi Basin
    // (id `ab`, map 529, the Scourge in the basin), reworked whole: a save naming `ab` is moved
    // on to this zone (`save::RENAMED_ZONES`).
    id: "sunken_temple",
    name: Area(1477),
    subtitle: "The Drowned Prophecy",
    description: "Atal'ai zealots and the nightmare-touched green dragons guard the sunken temple of the Blood God.",
    map_id: 109,
    area_id: 1477,
    // On the temple's lower floor.
    spawn: (
        x: -459.447784,
        y: 95.499008,
        z: -94.882286,
        facing: 0.002662,
    ),
    arena_radius: 80.0,
    // The pit in the middle of the lower floor (round, about 5 yd
    // from its centre, a 95 yd drop) is plugged with a round table, its top flush with the floor
    // round it (-94.96, lowered 0.15 yd so its model does not clip through) and its legs down in
    // the pit; the disc beneath is floor the run walks
    // and spawns on. The table is the small inn table (its top 2.1 yd across and 1.13 yd high at
    // scale 1), at x5.3 a top about 11 yd across over a pit 10 yd across.
    props: [
        (name: "Round Table", display_id: 6508, at: (x: -466.86, y: 95.13, z: -101.10, facing: 0.0), scale: 5.3),
    ],
    platforms: [
        (centre: (-466.86, 95.13), radius: 5.5, z: -94.96),
    ],
    enemy_spawn_ring: (30.0, 40.0),
    boss_spawn_ring: (25.0, 30.0),
    hour: 22,
    weather: (
        kind: None,
        intensity: 0.0,
    ),
    // The fifth zone, after the Scarlet Monastery.
    difficulty: 5.0,
    enemies: [
        (
            name: "Atal'ai Slave",
            display_id: 7554,
            scale: 1.0,
            creature_type: Demon,
            kind: Fodder,
            toughness: 0.5,
            appears_at_minute: 0.0,
        ),
        (
            name: "Nightmare Whelp",
            display_id: 621,
            scale: 1.0,
            creature_type: Dragonkin,
            kind: FastFodder,
            toughness: 0.25,
            appears_at_minute: 0.5,
        ),
        (
            name: "Hakkari Frostwing",
            display_id: 7569,
            scale: 1.0,
            creature_type: Beast,
            kind: FastFodder,
            toughness: 0.25,
            appears_at_minute: 1.0,
        ),
        (
            name: "Atal'ai Witch Doctor",
            display_id: 6670,
            scale: 1.0,
            creature_type: Humanoid,
            kind: Ranged,
            toughness: 0.5,
            appears_at_minute: 2.0,
            look_spell: Some(403),
        ),
        (
            name: "Atal'ai Warrior",
            display_id: 7709,
            scale: 1.0,
            creature_type: Humanoid,
            kind: Mid,
            toughness: 0.75,
            appears_at_minute: 3.0,
        ),
        (
            name: "Mummified Atal'ai",
            display_id: 4769,
            scale: 1.1,
            creature_type: Undead,
            kind: ToughMid,
            toughness: 2.0,
            appears_at_minute: 4.5,
        ),
        (
            name: "Atal'ai Deathwalker",
            display_id: 4773,
            scale: 1.0,
            creature_type: Undead,
            kind: Mid,
            toughness: 1.0,
            appears_at_minute: 6.0,
        ),
        (
            name: "Atal'ai Priest",
            display_id: 4776,
            scale: 1.0,
            creature_type: Humanoid,
            kind: Ranged,
            toughness: 0.75,
            appears_at_minute: 7.5,
            look_spell: Some(686),
        ),
        (
            name: "Nightmare Scalebane",
            display_id: 7903,
            scale: 1.0,
            creature_type: Dragonkin,
            kind: ToughMid,
            toughness: 3.0,
            appears_at_minute: 9.0,
        ),
        (
            name: "Nightmare Wanderer",
            display_id: 181,
            scale: 1.0,
            creature_type: Dragonkin,
            kind: Elite,
            appears_at_minute: 4.0,
        ),
        (
            name: "Nightmare Wyrmkin",
            display_id: 7863,
            scale: 1.2,
            creature_type: Dragonkin,
            kind: Elite,
            appears_at_minute: 8.5,
        ),
        (
            name: "Spawn of Hakkar",
            display_id: 4065,
            scale: 1.3,
            creature_type: Beast,
            kind: Elite,
            appears_at_minute: 13.0,
        ),
        // Only the bosses bring these (the Nightmare Suppressors that
        // heal the Shade of Eranikus); they never spawn by themselves.
        (
            name: "Nightmare Suppressor",
            display_id: 7974,
            scale: 1.0,
            creature_type: Humanoid,
            kind: Mid,
            toughness: 0.75,
            appears_at_minute: 0.0,
            only_summoned: true,
        ),
    ],
    // The bosses' mechanics (docs/game/bosses.md "Building blocks"):
    // every area attack is marked on the ground before it lands and hits the hero only. Each boss
    // keeps the damage a hero cannot avoid (`swing_mult` carries what its unmarked abilities did).
    bosses: [
        (
            name: "Atal'alarion",
            display_id: 7873,
            scale: 1.65,
            creature_type: Humanoid,
            spawn_minute: 4.0,
            yell: "I'll feast on your bones!",
            aggro_sound: Some(5860),
            swing_mult: Some(2.0),
            abilities: [
                // Sweeping Slam: a marked cone before him
                Marked(
                    shape: Cone(length: 12.0, angle: 80.0),
                    at: Boss,
                    impact_spell: 12887,
                    impact_on_bunny: true,
                    cooldown: Some(8.0),
                    warn: Some((text: "{Spell(12887)}: get behind him!", bar: Some("{Spell(12887)}"))),
                ),
                // Ground Tremor: the ground cracks in a ring round him, safe at his feet
                Marked(
                    shape: Ring(inner: 5.0, outer: 14.0),
                    at: Boss,
                    impact_spell: 6524,
                    wind_up: Some(1.8),
                    cooldown: Some(11.0),
                    warn: Some((text: "{Spell(6524)}: hug him or get clear!", bar: Some("{Spell(6524)}"))),
                ),
            ],
            is_final: false,
        ),
        (
            name: "Jammal'an the Prophet",
            display_id: 6708,
            scale: 1.90,
            creature_type: Humanoid,
            spawn_minute: 7.0,
            yell: "The Soulflayer comes!",
            aggro_sound: Some(5862),
            swing_mult: Some(1.271),
            abilities: [
                // Flamestrike at marked spots round the hero, leaving fire
                Marked(
                    shape: Circle(radius: 4.5),
                    at: NearHero(count: 2, spread: 8.0),
                    impact_spell: 12468,
                    cooldown: Some(10.0),
                    leaves: Some((look_spell: 12468, radius: 4.5, seconds: 6.0, damage_mult: 0.25)),
                    warn: Some((text: "{Spell(12468)}: out of the fire!", bar: Some("{Spell(12468)}"))),
                ),
                // a healing totem by him: walk over it to break it
                Lay(
                    object: (
                        name: "{Spell(5394)}",
                        display_id: 653,
                        // the original troll Healing Ward (creature 3560, vmangos)
                        creature_display: Some(2030),
                        scale: 1.0,
                        glow_spell: 20922,
                        pulse: Some((seconds: 3.0, run: [Heal(on: Near(12.0), share: 0.04, look_spell: 12492)])),
                    ),
                    near: Boss(5.0),
                    count: Some(1),
                    cooldown: Some(20.0),
                    warn: Some((text: "Healing totem: break it!", colour: Yellow, icon_spell: Some(5394), bar: Some("{Spell(5394)}"))),
                ),
                // an Earthgrab Totem near the hero that sends a marked ring round itself: break it
                Lay(
                    object: (
                        name: "{Spell(8376)}",
                        display_id: 4718,
                        // the original Earthgrab Totem (creature 6066, vmangos)
                        creature_display: Some(2420),
                        scale: 1.0,
                        glow_spell: 20922,
                        pulse: Some((seconds: 4.0, run: [Cast(ability: Marked(
                            shape: Ring(inner: 2.5, outer: 9.0),
                            at: Boss,
                            impact_spell: 8376,
                            damage_mult: Some(1.5),
                        ))])),
                    ),
                    near: Hero(7.0),
                    count: Some(1),
                    cooldown: Some(22.0),
                    warn: Some((text: "{Spell(8376)}: stand on it to break it!", colour: Yellow, icon_spell: Some(8376), bar: Some("{Spell(8376)}"))),
                ),
            ],
            is_final: false,
        ),
        (
            name: "Morphaz",
            display_id: 7975,
            scale: 0.55,
            creature_type: Dragonkin,
            spawn_minute: 11.0,
            yell: "You walk in a dream that is not yours. Wake into ours.",
            swing_mult: Some(2.0),
            abilities: [
                // Acid Breath: a marked cone leaving acid pools
                Marked(
                    shape: Cone(length: 16.0, angle: 60.0),
                    at: Boss,
                    impact_spell: 12884,
                    impact_on_bunny: true,
                    cooldown: Some(10.0),
                    leaves: Some((look_spell: 23861, radius: 3.0, seconds: 8.0, damage_mult: 0.2)),
                    warn: Some((text: "{Spell(12884)}: out of the cone!", colour: Green, bar: Some("{Spell(12884)}"))),
                ),
                // Wing Flap: a ring round him
                Marked(
                    shape: Ring(inner: 4.0, outer: 12.0),
                    at: Boss,
                    impact_spell: 12882,
                    cooldown: Some(9.0),
                    warn: Some((text: "{Spell(12882)}: hug him or get clear!", bar: Some("{Spell(12882)}"))),
                ),
            ],
            is_final: false,
        ),
        (
            name: "Avatar of Hakkar",
            display_id: 8053,
            // clearly bigger than the elites
            scale: 1.00,
            creature_type: NotSpecified,
            spawn_minute: 14.0,
            yell: "Blood for the Soulflayer. Your blood will do.",
            aggro_sound: Some(5871),
            swing_mult: Some(1.271),
            abilities: [
                // Lash: a marked line from him
                Marked(
                    shape: Line(length: 25.0, width: 4.0),
                    at: Boss,
                    impact_spell: 6607,
                    impact_on_bunny: true,
                    cooldown: Some(9.0),
                    warn: Some((text: "{Spell(6607)}: side-step the line!", bar: Some("{Spell(6607)}"))),
                ),
            ],
            script: [
                // shielded while four blood fires burn: walk onto each to put it out, as in the
                // original ritual
                (
                    on: Arrival,
                    warn: Some((text: "Put out the four blood fires to break his shield!", colour: Yellow, icon_spell: Some(642))),
                    run: [
                        Shield(damage_taken: 0.0, look_spell: 642),
                        Place(
                            object: (
                                name: "Eternal Flame",
                                display_id: 2570,
                                scale: 1.0,
                                glow_spell: 20922,
                                on_contact: [Emote(text: "A blood fire goes out!")],
                                on_all_taken: [Unshield, Emote(text: "%s's shield falls!")],
                            ),
                            near: Boss(14.0),
                            count: Some(4),
                        ),
                    ],
                ),
            ],
            is_final: false,
        ),
        (
            name: "Shade of Eranikus",
            display_id: 7806,
            scale: 1.0,
            creature_type: Dragonkin,
            spawn_minute: 18.0,
            yell: "The nightmare has me, and now it has you.",
            swing_mult: Some(1.771),
            abilities: [
                // Thrash: a flurry of blows marked round him
                Marked(
                    shape: Circle(radius: 6.0),
                    at: Boss,
                    impact_spell: 3391,
                    impact_on_bunny: true,
                    wind_up: Some(1.2),
                    cooldown: Some(8.0),
                    warn: Some((text: "{Spell(3391)}: step back!", bar: Some("{Spell(3391)}"))),
                ),
                // green Nightmare clouds drift after the hero
                Zone(
                    zone: (look_spell: 23861, radius: 5.0, seconds: 14.0, damage_mult: 0.3, drift: 2.0),
                    at: Boss,
                    cooldown: Some(10.0),
                    warn: Some((text: "Nightmare cloud: keep away from it!", colour: Green, icon_spell: Some(24778), bar: Some("Nightmare"))),
                ),
            ],
            script: [
                // Nightmare Suppressors come and heal him: kill them
                (
                    on: Every(25.0),
                    warn: Some((text: "Nightmare Suppressors: kill them before they heal him!", colour: Orange, icon_spell: Some(12623), bar: Some("Suppressors"))),
                    run: [
                        Emote(text: "%s calls his Nightmare Suppressors!"),
                        Wave(enemy: "Nightmare Suppressor", count: 3, at: Ring(12.0)),
                    ],
                ),
                (
                    on: Every(3.0),
                    run: [Heal(on: Myself, share: 0.01, look_spell: 0, beam_spell: 12623, beam_seconds: 3.5, from: Some("Nightmare Suppressor"))],
                ),
            ],
            is_final: true,
        ),
    ],
)
