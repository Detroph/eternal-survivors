// A zone: its arena, roster and boss schedule. The file name is the zone id.
// Zones are ordered by `difficulty`, ascending: that order is the unlock path and the order
// every list shows. Roster and ability numbers come from enemy_kinds.ron by kind.
(
    id: "wsg",
    name: Area(3277),
    // The gulch is held by the other faction's players, every class
    // of every race of that faction (zones.md, "Player-looking enemies"). Before: the Burning
    // Legion's demons ("Legion at the Gate").
    subtitle: "Capture the Flag",
    description: "The other faction holds the gulch: every class, every race, every bad habit, and their ranked champions.",
    map_id: 489,
    area_id: 3277,
    spawn: (
        x: 1230.0,
        y: 1450.0,
        z: 310.0,
        facing: 1.57,
    ),
    // The whole middle field is the arena, from the Horde's side in the
    // south to the Alliance's in the north, each ending at a line across the full width of the gulch
    // (each line straight across at its x). The circle, centred between them
    // and wide enough for the field, only catches strays.
    arena_centre: Some((1240.8, 1455.0)),
    arena_radius: 150.0,
    walls: [
        // the Horde's side, south: (1116.85, 1462.46)
        (from: (1116.85, 1000.0), to: (1116.85, 1900.0)),
        // the Alliance's side, north: (1364.76, 1461.69)
        (from: (1364.76, 1000.0), to: (1364.76, 1900.0)),
    ],
    enemy_spawn_ring: (30.0, 40.0),
    boss_spawn_ring: (25.0, 30.0),
    hour: 20,
    weather: (
        kind: None,
        intensity: 0.0,
    ),
    difficulty: 3.0,
    // Normal enemies: a joke picked for each (pvp_looks.ron jokes) before the class they look like; the server picks each one's race
    // of the other faction, gender, face and pre-raid gear. Melee for warriors, paladins, rogues,
    // melee shamans and feral druids (shown as cats); the rest stand and cast, hunters shoot.
    enemies: [
        (
            name: "{Joke} {Class(1)}",
            scale: 1.0,
            creature_type: Humanoid,
            kind: Fodder,
            toughness: 0.5,
            appears_at_minute: 0.0,
            looks_like: Some((class: "warrior")),
        ),
        (
            name: "{Joke} {Class(4)}",
            scale: 1.0,
            creature_type: Humanoid,
            kind: FastFodder,
            // our rule (owner): 7.16 x the game's enemy speed (0.95) = 6.8 yd/s, just under the
            // hero's 7 (the kind's 8 runs 7.6)
            move_speed: Some(7.16),
            toughness: 0.25,
            appears_at_minute: 0.5,
            looks_like: Some((class: "rogue")),
        ),
        (
            name: "{Joke} {Class(11)}",
            scale: 1.0,
